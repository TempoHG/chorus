<script>
  import { track } from "@vercel/analytics";

  track("free_website_page_view");

  document.querySelectorAll("[data-campaign-cta]").forEach((el) => {
    el.addEventListener("click", () => track("free_website_cta_click"));
  });

  const form = document.querySelector("[data-campaign-form]");
  if (form) {
    let started = false;
    form.addEventListener(
      "focus",
      () => {
        if (started) return;
        started = true;
        track("free_website_form_start");
      },
      true,
    );

    // Same best-effort heuristic as the Playbook page: GHL's form message
    // shape isn't publicly documented or verified here, unlike the booking
    // calendar's confirmed "msgsndr-booking-complete" shape below. Treat
    // anything from this iframe that isn't an iframeResizer height ping as
    // a submit signal.
    window.addEventListener("message", (event) => {
      if (event.source !== form.contentWindow) return;
      const data = event.data;
      const isResizePing = data && typeof data === "object" && "iframeResizer" in data;
      if (isResizePing) return;
      track("free_website_form_submit");
    });
  }

  // Confirmed message shape (see initDemoBookedTracking in motion.js) —
  // reliable, not a guess.
  window.addEventListener("message", (event) => {
    const data = event.data;
    if (!Array.isArray(data) || data[0] !== "msgsndr-booking-complete") return;
    track("free_website_demo_booked");
  });
</script>

<script is:inline src="https://links.tempohg.com/js/form_embed.js"></script>
