---
import Base from "../layouts/Base.astro";

// The existing demo booking calendar. WIDGET_ID must match the id GHL's
// form_embed.js looks for when it posts the resize message back.
const GHL_DOMAIN = "https://links.tempohg.com";
const CALENDAR_ID = "I5Q7FwuP2H7GVLaL1Cai";
const WIDGET_ID = "yVHkwu10vymju35mIkBW_1786414705061";
---

<Base
  title="Book a Demo — Tempo Chorus"
  description="Let's see what Chorus could do for your restaurant. No generic software tour. We'll focus on the parts of Chorus that could actually help."
  active="book-a-demo"
>
  <section class="lead">
    <div class="shell lead__inner">
      <h1 class="lead__title">Let's see what Chorus could do for your restaurant.</h1>
      <p class="lede lead__sub">
        No generic software tour. We'll focus on the parts of Chorus that could actually help your restaurant.
      </p>
    </div>
  </section>

  <section class="booking" aria-label="Pick a time">
    <div class="shell">
      <iframe
        class="booking__frame"
        src={`${GHL_DOMAIN}/widget/booking/${CALENDAR_ID}`}
        title="Book a Tempo Chorus demo"
        allow="payment"
        scrolling="no"
        id={WIDGET_ID}
      ></iframe>
    </div>
  </section>
</Base>

<style>
  section {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .lead {
    padding-top: clamp(5rem, 12vw, 9rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .lead__title {
    font-size: clamp(2.4rem, 1.2rem + 4.6vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--eggplant);
    max-width: 20ch;
  }

  .lead__sub {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    color: var(--v3-text-mid);
  }

  .booking__frame {
    display: block;
    width: 100%;
    min-height: 720px;
    border: 0;
    background: transparent;
  }
</style>

<script is:inline src={`${GHL_DOMAIN}/js/form_embed.js`}></script>

