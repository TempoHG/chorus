---
import Base from "../layouts/Base.astro";
import FeatureArt from "../components/FeatureArt.astro";

const categories = [
  {
    id: "get-found",
    name: "Get Found",
    line: "Make it easier for guests to find — and choose — you.",
    art: "calendar" as const,
    items: [
      {
        name: "Google Business",
        desc: "Connect your Google presence with Chorus.",
      },
      {
        name: "Menus Made for the Web",
        desc: "Fast, mobile-friendly menus guests can actually browse.",
      },
      {
        name: "Landing Pages",
        desc: "Create focused pages for promotions, events, catering, hiring and campaigns.",
      },
      {
        name: "Forms & Lead Capture",
        desc: "Capture guest inquiries and information directly into Chorus.",
      },
      {
        name: "Social Publishing",
        desc: "Plan, schedule and publish social content from one place.",
      },
      {
        name: "Advertising Tools",
        desc: "Keep paid activity connected to your marketing.",
      },
    ],
    callout: {
      title: "Social, without living on your phone",
      body: "Plan, schedule and publish your social content from one place, then respond to messages as they come in — without jumping between apps. Spend less time posting and more time running your restaurant.",
    },
  },
  {
    id: "stay-connected",
    name: "Stay Connected",
    line: "Be there when guests reach out.",
    art: "inbox" as const,
    items: [
      {
        name: "AI Host Helper",
        desc: "Answer calls and capture opportunities when your team can't.",
      },
      {
        name: "Unified Guest Inbox",
        desc: "Bring guest conversations together so your team has one place to respond.",
      },
      {
        name: "Email",
        desc: "Communicate directly with guests from Chorus.",
      },
      {
        name: "Text Messaging",
        desc: "Send and receive guest SMS conversations.",
      },
      {
        name: "Phone",
        desc: "Manage restaurant calls and guest communication through Chorus.",
      },
      {
        name: "Missed-Call Text Back",
        desc: "Automatically text guests when your team can't answer the phone.",
      },
      {
        name: "Website Live Chat",
        desc: "Let website visitors start a conversation directly with your restaurant.",
      },
      {
        name: "Facebook & Instagram Messaging",
        desc: "Bring social conversations into your guest communication system.",
      },
      {
        name: "Guest Database",
        desc: "Keep guest contact information, conversations, activity and relationships connected.",
      },
    ],
    callout: {
      title: "AI Host Helper gets its own home",
      body: "See exactly how it handles a call, start to finish, on the AI Host Helper page.",
    },
  },
  {
    id: "bring-guests-back",
    name: "Bring Guests Back",
    line: "The first visit shouldn't be the last conversation.",
    art: "reviews" as const,
    items: [
      {
        name: "Email Campaigns",
        desc: "Send promotions, announcements, newsletters and restaurant updates.",
      },
      {
        name: "SMS Campaigns",
        desc: "Reach opted-in guests with timely offers, events and messages.",
      },
      {
        name: "Review Requests",
        desc: "Automatically ask guests for reviews and make it easy to leave one.",
      },
      {
        name: "Reputation Management",
        desc: "Monitor and manage guest reviews from Chorus.",
      },
      {
        name: "Birthday Club",
        desc: "Capture birthdays and automatically bring guests back around their birthday.",
      },
      {
        name: "Win-Back Campaigns",
        desc: "Re-engage guests who haven't visited or interacted recently.",
      },
      {
        name: "Promotions & Offers",
        desc: "Create campaigns around specials, events and other reasons to return.",
      },
      {
        name: "Automated Guest Follow-Up",
        desc: "Keep conversations and opportunities moving without relying on someone to remember every follow-up.",
      },
      {
        name: "Guest Segmentation",
        desc: "Build targeted audiences based on guest information and behavior.",
      },
      {
        name: "Guest Recovery",
        desc: "Route poor guest experiences to the restaurant team so problems can be addressed quickly.",
      },
    ],
    callout: {
      title: "Private events and catering get their own home",
      body: "Every inquiry, organized from first message to booked event — see how on the Private Events & Catering page.",
    },
  },
  {
    id: "save-time",
    name: "Save Time",
    line: "Let Chorus remember the next step.",
    art: "reservations" as const,
    items: [
      {
        name: "Marketing Automations",
        desc: "Automate repetitive marketing and guest communication tasks.",
      },
      {
        name: "Social Scheduling",
        desc: "Plan content ahead and keep the restaurant's social calendar moving.",
      },
      {
        name: "Calendars & Scheduling",
        desc: "Manage appointments, meetings and scheduled interactions.",
      },
      {
        name: "Internal Notifications",
        desc: "Alert the right team member when a guest or opportunity needs attention.",
      },
      {
        name: "Automated Responses",
        desc: "Give guests an immediate response while the team handles the next step.",
      },
      {
        name: "Marketing Calendar",
        desc: "Organize campaigns and communication around one schedule.",
      },
      {
        name: "Workflow Automation",
        desc: "Build multi-step processes around inquiries, guest activity and follow-up.",
      },
      {
        name: "Basic AI Assistance",
        desc: "Help the team draft content, messages and responses faster.",
      },
      {
        name: "Reporting",
        desc: "See activity and performance across Chorus.",
      },
      {
        name: "Campaign Reporting",
        desc: "Understand how email, SMS and other campaigns are performing.",
      },
      {
        name: "Guest Reporting",
        desc: "Better understand the audience being built inside Chorus.",
      },
      {
        name: "Advertising Tools",
        desc: "Organize and manage digital advertising activity.",
      },
    ],
  },
];

const underTheHood = [
  "Websites", "Forms", "Funnels", "Guest records", "Email", "SMS", "Phone",
  "Social", "Reviews", "Calendars", "Workflows", "Pipelines", "Surveys",
  "Documents", "Reporting", "AI", "Integrations",
];

const workflows = [
  { name: "Private Events", steps: ["Capture", "Respond", "Notify", "Follow Up", "Book"] },
  { name: "Catering", steps: ["Inquire", "Organize", "Follow Up", "Close"] },
  { name: "Guest Recovery", steps: ["Feedback", "Alert", "Respond", "Recover"] },
  { name: "Birthdays", steps: ["Capture", "Remember", "Invite Back"] },
  { name: "Reviews", steps: ["Visit", "Ask", "Review", "Respond"] },
  { name: "Missed Calls", steps: ["Missed Call", "Text Back", "Continue"] },
];

---

<Base
  title="Everything you need — Tempo Chorus"
  description="Guest communication, marketing, reputation, relationships and automation — connected around your restaurant."
  active="features"
>
  <section class="lead">
    <div class="shell">
      <h1 class="lead__title">
        Everything you need.<br />
        <span class="lead__accent">Working together.</span>
      </h1>
      <p class="lead__sub">
        Guest communication, marketing, reputation, relationships and automation —
        connected around your restaurant.
      </p>
      <div class="lead__jump">
        <p>Jump to</p>
        <ul>
          {categories.map((c) => <li><a href={`#${c.id}`}>{c.name}</a></li>)}
          <li><a href="/ai-host-helper">AI Host Helper</a></li>
          <li><a href="/guest-marketing">Guest Marketing</a></li>
          <li><a href="/manage-reviews">Manage Reviews</a></li>
          <li><a href="/private-events-catering">Private Events & Catering</a></li>
        </ul>
      </div>
    </div>
  </section>

  <div class="categories">
    <div class="shell">
      {
        categories.map((c, i) => (
          <article class="category" id={c.id}>
            <div class={`category__head ${i % 2 === 1 ? "category__head--flip" : ""}`}>
              <div class="category__say">
                <h2 class="category__name">{c.name}</h2>
                <p class="category__line">{c.line}</p>
              </div>
              <div class="category__show">
                <FeatureArt kind={c.art} />
              </div>
            </div>
            <ul class="category__grid" data-reveal>
              {c.items.map((item) => (
                <li>
                  <span class="dot" aria-hidden="true" />
                  <div>
                    <p class="category__item-name">{item.name}</p>
                    <p class="category__item-desc">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
            {c.callout && (
              <div class="category__callout">
                <p class="category__callout-title">{c.callout.title}</p>
                <p class="category__callout-body">{c.callout.body}</p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>

  <section class="teaser" id="ai-host-helper" aria-labelledby="teaser-title">
    <div class="shell teaser__inner">
      <p class="teaser__label">AI Host Helper</p>
      <h2 class="teaser__title" id="teaser-title">Your host stand could use another set of hands.</h2>
      <p class="lede teaser__body">
        Answers when your team can't — during the rush, after hours, or whenever the phone
        competes with the guests in front of you.
      </p>
      <a class="teaser__link" href="/ai-host-helper">See how it works →</a>
    </div>
  </section>

  <section class="hood" id="under-the-hood" aria-labelledby="hood-title">
    <div class="shell">
      <h2 class="eyeless-h2 hood__title" id="hood-title">Under the hood.</h2>
      <p class="lede hood__lede">
        A platform built to keep growing — not a fixed feature count.
      </p>
      <p class="hood__cloud">
        {underTheHood.map((w, i) => (
          <>
            <span class="hood__word">{w}</span>
            {i < underTheHood.length - 1 && (
              <>
                {" "}
                <span class="hood__sep" aria-hidden="true">
                  ·
                </span>{" "}
              </>
            )}
          </>
        ))}
      </p>
    </div>
  </section>

  <section class="workflows" aria-labelledby="workflows-title">
    <div class="shell">
      <p class="workflows__label">Built for Restaurants</p>
      <h2 class="workflows__title" id="workflows-title">
        Not generic workflows with a restaurant logo on them.
      </h2>
      <ul class="workflows__list" data-reveal>
        {workflows.map((w) => (
          <li>
            <p class="workflows__name">{w.name}</p>
            <p class="workflows__chain">
              {w.steps.map((step, i) => (
                <>
                  <span>{step}</span>
                  {i < w.steps.length - 1 && <span class="workflows__arrow" aria-hidden="true">→</span>}
                </>
              ))}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="close">
    <div class="shell close__inner">
      <h2 class="close__title">
        All Together<br />
        <span class="close__accent">Now.</span>
      </h2>
      <p class="close__sub">You don't need another disconnected tool.</p>
      <p class="close__statement">
        You need the pieces around your guests to work together.
      </p>
      <a class="btn" href="/#demo">Book a Demo</a>
    </div>
  </section>
</Base>

<style>
  .lead {
    padding-block: clamp(4rem, 10vw, 7.5rem) clamp(3rem, 7vw, 5rem);
  }

  .lead__title {
    font-size: clamp(2.75rem, 1.1rem + 6vw, 5.6rem);
    letter-spacing: -0.045em;
  }

  .lead__accent {
    color: var(--mint-400);
  }

  .lead__sub {
    margin-top: 1.75rem;
    max-width: 58ch;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    line-height: 1.5;
    color: var(--text-mid);
  }

  .lead__jump {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 26%, transparent);
  }

  .lead__jump p {
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-low);
  }

  .lead__jump ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
  }

  .lead__jump a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--violet-400);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .lead__jump a:hover {
    color: var(--text-hi);
    border-bottom-color: var(--mint-400);
  }

  .categories {
    background: var(--ink-800);
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .category {
    padding-block: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 24%, transparent);
    scroll-margin-top: 5.5rem;
  }

  .category:first-child {
    border-top: 0;
  }

  .category__head {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .category__head--flip .category__show {
    order: 2;
  }

  .category__name {
    font-size: clamp(1.65rem, 1rem + 2.2vw, 2.75rem);
    letter-spacing: -0.038em;
    color: var(--text-hi);
  }

  .category__line {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 0.95rem + 0.9vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--violet-400);
    max-width: 32ch;
  }

  .category__grid {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.35rem 2.5rem;
  }

  .category__grid li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .category__grid .dot {
    margin-top: 0.55em;
    color: var(--mint-400);
  }

  .category__item-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--text-hi);
  }

  .category__item-desc {
    margin-top: 0.3rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-mid);
  }

  .category__callout {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 22%, transparent);
    max-width: 46ch;
  }

  .category__callout-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.025em;
    color: var(--text-hi);
  }

  .category__callout-body {
    margin-top: 0.5rem;
    color: var(--text-mid);
    line-height: 1.55;
  }

  @media (max-width: 60rem) {
    .category__head {
      grid-template-columns: 1fr;
    }
    .category__head--flip .category__show {
      order: 0;
    }
  }

  @media (max-width: 40rem) {
    .category__grid {
      grid-template-columns: 1fr;
    }
  }

  .hood {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .hood__lede {
    margin-top: 1.25rem;
    color: var(--text-low);
  }

  .hood__cloud {
    margin-top: clamp(2rem, 5vw, 3rem);
    max-width: 68ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.25rem);
    line-height: 1.9;
    color: var(--text-mid);
  }

  .hood__word {
    color: var(--text-hi);
  }

  .hood__sep {
    color: var(--violet-500);
    margin: 0 0.55em;
  }

  /* ---------- AI Host Helper teaser ---------- */

  .teaser {
    padding-block: clamp(4rem, 9vw, 6.5rem);
    background: var(--ink-800);
  }

  .teaser__inner {
    max-width: 46rem;
  }

  .teaser__label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-low);
  }

  .teaser__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.65rem, 1rem + 2.2vw, 2.5rem);
    letter-spacing: -0.038em;
  }

  .teaser__body {
    margin-top: 1rem;
  }

  .teaser__link {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--violet-400);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease-out);
  }

  .teaser__link:hover {
    border-bottom-color: var(--violet-400);
  }

  /* ---------- Built for restaurants (workflow chains) ---------- */

  .workflows {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .workflows__label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-low);
  }

  .workflows__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.65rem, 1rem + 2.2vw, 2.75rem);
    letter-spacing: -0.038em;
    max-width: 24ch;
  }

  .workflows__list {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2.5rem;
  }

  .workflows__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-hi);
  }

  .workflows__chain {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-mid);
  }

  .workflows__arrow {
    color: var(--violet-400);
  }

  @media (max-width: 40rem) {
    .workflows__list {
      grid-template-columns: 1fr;
    }
  }

  .close {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .close__title {
    font-size: clamp(2.1rem, 1.1rem + 3.2vw, 3.5rem);
    letter-spacing: -0.04em;
  }

  .close__accent {
    color: var(--mint-400);
  }

  .close__sub {
    margin-top: 1.6rem;
    max-width: 56ch;
    color: var(--text-mid);
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
  }

  .close__sub + .close__sub {
    margin-top: 1rem;
  }

  .close__statement {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 0.95rem + 1.7vw, 2.1rem);
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.03em;
    color: var(--text-hi);
    max-width: 44ch;
  }

  .close__inner .btn {
    margin-top: 2.4rem;
  }
</style>
