---
import Base from "../layouts/Base.astro";
import FeatureArt from "../components/FeatureArt.astro";

const categories = [
  {
    id: "get-found",
    name: "Get Found",
    line: "Help more guests discover and choose the restaurant.",
    art: "calendar" as const,
    items: [
      "Website tools and landing pages",
      "Forms and lead capture",
      "Social planning and publishing",
      "Google and local presence tools",
      "Promotions",
      "Advertising tools where applicable",
    ],
    callout: {
      title: "Social, without living on your phone",
      body: "Plan, schedule and publish your social content from one place, then respond to messages as they come in — without jumping between apps. Spend less time posting and more time running your restaurant.",
    },
  },
  {
    id: "stay-connected",
    name: "Stay Connected",
    line: "Make it easier for guests to reach the restaurant, and the team to respond.",
    art: "inbox" as const,
    items: [
      "Unified inbox",
      "Phone",
      "Two-way text",
      "Email",
      "Social messaging",
      "Web chat",
      "Missed-call recovery",
      "Calendars and scheduling",
    ],
  },
  {
    id: "bring-guests-back",
    name: "Bring Guests Back",
    line: "Build repeat visits and stronger relationships.",
    art: "reviews" as const,
    items: [
      "Guest database",
      "Email and SMS campaigns",
      "Reviews",
      "Birthdays",
      "Win-back campaigns",
      "Offers",
      "Segmentation",
      "Follow-up",
    ],
  },
  {
    id: "save-time",
    name: "Save Time",
    line: "Automate the repetitive marketing and communication work.",
    art: "reservations" as const,
    items: [
      "Workflow automation",
      "Social scheduling",
      "Automated responses",
      "Reminders",
      "Internal notifications",
      "AI assistance",
      "Reporting",
    ],
  },
];

const underTheHood = [
  "Websites", "Forms", "Funnels", "Guest records", "Email", "SMS", "Phone",
  "Social", "Reviews", "Calendars", "Workflows", "Pipelines", "Surveys",
  "Documents", "Reporting", "AI", "Integrations",
];
---

<Base
  title="What Tempo Chorus does — everything working together"
  description="Get Found, Stay Connected, Bring Guests Back, Save Time — what Tempo Chorus actually does for a restaurant, in plain language."
  active="features"
>
  <section class="lead">
    <div class="shell">
      <h1 class="lead__title">
        Everything your restaurant needs.<br />
        <span class="lead__accent">Working together.</span>
      </h1>
      <p class="lead__sub">
        Tempo Chorus connects marketing, communication, guest relationships,
        reputation, automation and more into one platform — not a fixed list
        of features, but a system that keeps growing with your restaurant.
      </p>
      <div class="lead__jump">
        <p>Jump to</p>
        <ul>
          {categories.map((c) => <li><a href={`#${c.id}`}>{c.name}</a></li>)}
          <li><a href="#under-the-hood">Under the Hood</a></li>
        </ul>
      </div>
    </div>
  </section>

  <div class="categories">
    <div class="shell">
      {
        categories.map((c, i) => (
          <article class={`category ${i % 2 === 1 ? "category--flip" : ""}`} id={c.id}>
            <div class="category__say">
              <h2 class="category__name">{c.name}</h2>
              <p class="category__line">{c.line}</p>
              <ul class="category__items">
                {c.items.map((item) => (
                  <li>
                    <span class="dot" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
              {c.callout && (
                <div class="category__callout">
                  <p class="category__callout-title">{c.callout.title}</p>
                  <p class="category__callout-body">{c.callout.body}</p>
                </div>
              )}
            </div>
            <div class="category__show">
              <FeatureArt kind={c.art} />
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <section class="hood" id="under-the-hood" aria-labelledby="hood-title">
    <div class="shell">
      <h2 class="eyeless-h2 hood__title" id="hood-title">Under the hood.</h2>
      <p class="lede hood__lede">
        A platform built to keep growing — not a fixed feature count.
      </p>
      <p class="hood__cloud">
        {underTheHood.map((w, i) => (
          <>
            <span class="hood__word">{w}</span>
            {i < underTheHood.length - 1 && (
              <>
                {" "}
                <span class="hood__sep" aria-hidden="true">
                  ·
                </span>{" "}
              </>
            )}
          </>
        ))}
      </p>
    </div>
  </section>

  <section class="close">
    <div class="shell close__inner">
      <h2 class="close__title">
        Many interactions.<br />
        <span class="close__accent">One relationship.</span>
      </h2>
      <p class="close__sub">
        Every call, reservation, review, text message, and return visit belongs
        to the same guest.
      </p>
      <p class="close__sub">
        Tempo Chorus keeps every conversation connected, so nothing gets lost
        and every interaction builds on the last.
      </p>
      <p class="close__statement">
        Because your guests experience one restaurant.<br />
        Your platform should too.
      </p>
      <a class="btn" href="/#demo">Book a demo</a>
    </div>
  </section>
</Base>

<style>
  .lead {
    padding-block: clamp(4rem, 10vw, 7.5rem) clamp(3rem, 7vw, 5rem);
  }

  .lead__title {
    font-size: clamp(2.75rem, 1.1rem + 6vw, 5.6rem);
    letter-spacing: -0.045em;
  }

  .lead__accent {
    color: var(--mint-400);
  }

  .lead__sub {
    margin-top: 1.75rem;
    max-width: 58ch;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    line-height: 1.5;
    color: var(--text-mid);
  }

  .lead__jump {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 26%, transparent);
  }

  .lead__jump p {
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-low);
  }

  .lead__jump ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
  }

  .lead__jump a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--violet-400);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .lead__jump a:hover {
    color: var(--text-hi);
    border-bottom-color: var(--mint-400);
  }

  .categories {
    background: var(--ink-800);
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .category {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 24%, transparent);
    scroll-margin-top: 5.5rem;
  }

  .category:first-child {
    border-top: 0;
  }

  .category--flip .category__show {
    order: 2;
  }

  .category__name {
    font-size: clamp(1.65rem, 1rem + 2.2vw, 2.75rem);
    letter-spacing: -0.038em;
    color: var(--text-hi);
  }

  .category__line {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 0.95rem + 0.9vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--violet-400);
    max-width: 32ch;
  }

  .category__items {
    list-style: none;
    margin: 1.85rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .category__items li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--text-hi);
    font-size: 1rem;
    line-height: 1.45;
  }

  .category__items .dot {
    color: var(--violet-400);
  }

  .category__callout {
    margin-top: 1.85rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 22%, transparent);
    max-width: 46ch;
  }

  .category__callout-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.025em;
    color: var(--text-hi);
  }

  .category__callout-body {
    margin-top: 0.5rem;
    color: var(--text-mid);
    line-height: 1.55;
  }

  @media (max-width: 60rem) {
    .category {
      grid-template-columns: 1fr;
    }
    .category--flip .category__show {
      order: 0;
    }
  }

  .hood {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .hood__lede {
    margin-top: 1.25rem;
    color: var(--text-low);
  }

  .hood__cloud {
    margin-top: clamp(2rem, 5vw, 3rem);
    max-width: 68ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.25rem);
    line-height: 1.9;
    color: var(--text-mid);
  }

  .hood__word {
    color: var(--text-hi);
  }

  .hood__sep {
    color: var(--violet-500);
    margin: 0 0.55em;
  }

  .close {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .close__title {
    font-size: clamp(2.1rem, 1.1rem + 3.2vw, 3.5rem);
    letter-spacing: -0.04em;
  }

  .close__accent {
    color: var(--mint-400);
  }

  .close__sub {
    margin-top: 1.6rem;
    max-width: 56ch;
    color: var(--text-mid);
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
  }

  .close__sub + .close__sub {
    margin-top: 1rem;
  }

  .close__statement {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 0.95rem + 1.7vw, 2.1rem);
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.03em;
    color: var(--text-hi);
    max-width: 44ch;
  }

  .close__inner .btn {
    margin-top: 2.4rem;
  }
</style>
