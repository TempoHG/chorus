---
import Base from "../layouts/Base.astro";

const areas = [
  {
    id: "guest-relations",
    name: "Guest Relations",
    head: "Be easy to find, easy to reach.",
    items: ["Website", "AI Host Helper", "Guest communication", "Forms + guest capture", "Google Business Profile", "SEO"],
    visual: "rank",
  },
  {
    id: "guest-marketing",
    name: "Guest Marketing",
    head: "Give guests a reason to come back.",
    items: ["Email", "Text", "Social", "Birthdays", "Promotions", "Win-back campaigns", "Guest segmentation"],
    visual: "campaign",
  },
  {
    id: "reputation",
    name: "Reputation",
    head: "Build it. Protect it.",
    items: ["Review requests", "Review monitoring", "Response management", "Guest feedback", "Guest recovery"],
    visual: "review",
  },
  {
    id: "opportunities",
    name: "Opportunities",
    head: "Don't let good leads disappear.",
    items: ["Private events", "Catering", "Inquiry capture", "Manager notifications", "Follow-up", "Lead tracking"],
    visual: "lead",
  },
];

const guestHistory = [
  { when: "Mar 3", what: "Visited", detail: "Party of 4 · Table 12" },
  { when: "Mar 12", what: "Called", detail: "Reservation booked by AI Host Helper" },
  { when: "Apr 2", what: "Private-event inquiry", detail: "24 guests · Manager notified" },
  { when: "Apr 9", what: "Review", detail: "★★★★★ · Response ready" },
  { when: "May 14", what: "Birthday club", detail: "Welcome sent" },
  { when: "Jun 1", what: "Email", detail: "Opened · Clicked patio menu" },
];

const nextSteps = [
  { trigger: "New birthday member", action: "Welcome" },
  { trigger: "Private-event inquiry", action: "Follow up" },
  { trigger: "Poor guest experience", action: "Alert manager" },
  { trigger: "Missed call", action: "Text back" },
  { trigger: "Guest hasn't returned", action: "Reconnect" },
  { trigger: "Great visit", action: "Ask for review" },
];
---

<Base
  title="Product — Tempo Chorus"
  description="Chorus connects the ways guests find you, reach you and come back, so your team has less to manage and fewer opportunities fall through the cracks."
  active="product"
>
  <section class="lead">
    <div class="shell">
      <h1 class="lead__title">Everything working together.</h1>
      <p class="lead__sub">
        Chorus connects the ways guests find you, reach you and come back, so your team has less to
        manage and fewer opportunities fall through the cracks.
      </p>
      <a class="btn lead__cta" href="/book-a-demo">Book a Demo</a>
    </div>
  </section>

  {areas.map((a) => (
    <section class="area" id={a.id} aria-labelledby={`${a.id}-title`}>
      <div class="shell area__inner">
        <div class="area__split">
          <div class="area__copy">
            <p class="eyebrow">{a.name}</p>
            <h2 class="section-title" id={`${a.id}-title`}>{a.head}</h2>
            <ul class="area__items">
              {a.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="area__visual">
            {a.visual === "rank" && (
              <div class="panel panel--rank" data-panel="rank" aria-hidden="true">
                <div class="panel__head">
                  <svg class="panel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m21 21-4.3-4.3" />
                  </svg>
                  <span class="panel__label" data-type-text>Pasta near me</span>
                  <span class="panel__caret"></span>
                </div>
                <ul class="panel__rows">
                  <li class="panel__row panel__row--primary" data-row>
                    <span class="panel__badge">1</span>
                    <span class="panel__thumb"></span>
                    <div class="panel__lines">
                      <p class="panel__name">Lou Amari's</p>
                      <p class="panel__meta">★★★★★ · Italian · 0.4 mi</p>
                    </div>
                  </li>
                  <li class="panel__row panel__row--ghost" data-row>
                    <span class="panel__badge">2</span>
                    <span class="panel__thumb panel__thumb--ghost"></span>
                    <div class="panel__lines">
                      <span class="panel__bar panel__bar--wide"></span>
                      <span class="panel__bar panel__bar--narrow"></span>
                    </div>
                  </li>
                  <li class="panel__row panel__row--ghost" data-row>
                    <span class="panel__badge">3</span>
                    <span class="panel__thumb panel__thumb--ghost"></span>
                    <div class="panel__lines">
                      <span class="panel__bar panel__bar--wide"></span>
                      <span class="panel__bar panel__bar--narrow"></span>
                    </div>
                  </li>
                </ul>
              </div>
            )}

            {a.visual === "campaign" && (
              <div class="panel panel--campaign" data-panel="campaign" aria-hidden="true">
                <div class="panel__head">
                  <svg class="panel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                  </svg>
                  <span class="panel__label" data-type-text>Win-back · 90 days</span>
                  <span class="panel__caret"></span>
                </div>
                <ul class="panel__rows">
                  <li class="panel__row panel__row--primary" data-row>
                    <span class="panel__badge panel__badge--icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="M22 6.5 12 13 2 6.5" />
                      </svg>
                    </span>
                    <div class="panel__lines">
                      <p class="panel__name">Email</p>
                      <p class="panel__meta panel__meta--done">Sent ✓ · 182 guests</p>
                    </div>
                  </li>
                  <li class="panel__row panel__row--ghost" data-row>
                    <span class="panel__badge panel__badge--icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
                      </svg>
                    </span>
                    <div class="panel__lines">
                      <p class="panel__name">Text</p>
                      <p class="panel__meta">Scheduled</p>
                    </div>
                  </li>
                  <li class="panel__row panel__row--ghost" data-row>
                    <span class="panel__badge panel__badge--icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="18" cy="5" r="3" />
                        <circle cx="6" cy="12" r="3" />
                        <circle cx="18" cy="19" r="3" />
                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                      </svg>
                    </span>
                    <div class="panel__lines">
                      <p class="panel__name">Social</p>
                      <p class="panel__meta">Scheduled</p>
                    </div>
                  </li>
                </ul>
              </div>
            )}

            {a.visual === "review" && (
              <div class="panel panel--review" data-panel="review" aria-hidden="true">
                <div class="panel__head panel__head--notify">
                  <span class="panel__pulse" data-pulse></span>
                  <span class="panel__notify-label">New review</span>
                  <span class="panel__notify-meta">Google · just now</span>
                </div>
                <ul class="panel__rows">
                  <li class="panel__row panel__row--primary" data-row>
                    <div class="panel__lines">
                      <p class="panel__stars" aria-label="5 out of 5 stars">★★★★★</p>
                      <p class="panel__quote">"Great dinner. Our server was fantastic."</p>
                      <p class="panel__meta">Sarah M. · Google</p>
                    </div>
                  </li>
                  <li class="panel__row panel__row--ghost" data-row>
                    <div class="panel__lines">
                      <p class="panel__meta">Response drafted</p>
                    </div>
                  </li>
                  <li class="panel__row panel__row--ghost" data-row>
                    <div class="panel__lines">
                      <p class="panel__meta panel__meta--done">Response sent ✓</p>
                    </div>
                  </li>
                </ul>
              </div>
            )}

            {a.visual === "lead" && (
              <div class="panel panel--lead" data-panel="lead" aria-hidden="true">
                <div class="panel__head panel__head--notify">
                  <span class="panel__pulse" data-pulse></span>
                  <span class="panel__notify-label">New inquiry</span>
                  <span class="panel__notify-meta">Private event</span>
                </div>
                <ul class="panel__rows">
                  <li class="panel__row panel__row--primary" data-row>
                    <div class="panel__lines">
                      <p class="panel__name">Private event · 42 guests</p>
                      <p class="panel__meta">Dec 14 · 6:30 PM</p>
                    </div>
                  </li>
                  <li class="panel__row panel__row--ghost" data-row>
                    <div class="panel__lines">
                      <p class="panel__meta panel__meta--done">Manager notified ✓</p>
                    </div>
                  </li>
                  <li class="panel__row panel__row--ghost" data-row>
                    <div class="panel__lines">
                      <p class="panel__meta panel__meta--done">Follow-up scheduled ✓</p>
                    </div>
                  </li>
                </ul>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="history" aria-labelledby="history-title">
    <div class="shell history__inner">
      <div class="history__say">
        <p class="eyebrow">One Guest. One History.</p>
        <h2 class="section-title" id="history-title">Every interaction belongs to the same guest.</h2>
        <p class="lede">
          Every interaction adds to what you know about a guest. Chorus keeps that relationship connected,
          so individual tools become one picture of the guest.
        </p>
      </div>
      <div class="record" aria-label="Example guest record: Sarah Chen, with her visits, calls, inquiry, review and email activity">
        <p class="record__name">Sarah Chen</p>
        <p class="record__meta">Since March · 6 visits</p>
        <ol class="record__timeline">
          {guestHistory.map((h) => (
            <li>
              <span class="record__when">{h.when}</span>
              <span class="record__what">{h.what}</span>
              <span class="record__detail">{h.detail}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="next" aria-labelledby="next-title">
    <div class="shell">
      <p class="eyebrow">Chorus Remembers the Next Step.</p>
      <h2 class="section-title" id="next-title">Things that used to depend on somebody remembering now happen on their own.</h2>
      <ul class="next__list">
        {nextSteps.map((n) => (
          <li class="next__row">
            <span class="next__trigger">{n.trigger}</span>
            <span class="next__arrow" aria-hidden="true">→</span>
            <span class="next__action">{n.action}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="shell close__inner">
      <h2 class="close__title" id="close-title">Less software to think about. More restaurant to run.</h2>
      <a class="btn" href="/book-a-demo">Book a Demo</a>
    </div>
  </section>
</Base>

<style>
  section {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .eyebrow {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--v3-text-low);
  }

  .section-title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.4rem);
    letter-spacing: -0.035em;
    color: var(--eggplant);
    max-width: 22ch;
  }

  .lede {
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    color: var(--v3-text-mid);
    max-width: 48ch;
  }

  /* Lead */
  .lead {
    padding-top: clamp(5rem, 12vw, 9rem);
    padding-bottom: clamp(3.5rem, 8vw, 5rem);
  }

  .lead__title {
    font-size: clamp(2.8rem, 1.2rem + 6vw, 6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--eggplant);
  }

  .lead__sub {
    margin-top: 1.75rem;
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.4rem);
    color: var(--v3-text-mid);
    max-width: 44ch;
  }

  .lead__cta {
    margin-top: 2.25rem;
  }

  /* Four product areas: hairline-separated, each given room. */
  .area {
    border-top: 1px solid color-mix(in oklab, var(--eggplant) 14%, transparent);
  }

  .area__items {
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--eggplant);
  }

  .area__items li {
    padding-bottom: 0.7rem;
    border-bottom: 1px solid color-mix(in oklab, var(--eggplant) 10%, transparent);
  }

  @media (max-width: 52rem) {
    .area__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .area__items {
      grid-template-columns: 1fr;
    }
  }

  /* Guest Relations only: copy on the left, a search-ranking graphic on
     the right — the item list narrows from 3 columns to 2 in this half-
     width context. */
  .area__split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .area__copy .area__items {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 52rem) {
    .area__split {
      grid-template-columns: 1fr;
    }
  }

  /* ---- The four product-area graphics share one visual grammar — a
     tinted panel holding a white "head" pill (a typed query/trigger, or a
     live notification) above a stack of rows that rise in, hold, fade and
     loop (see initProductPanels() in motion.js). Each area gets its own
     background tint and row content so the four read as related but not
     identical — same discipline as the homepage's Chorus in Action demos. ---- */

  .panel {
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: 8px;
  }

  .panel--rank {
    background: var(--sky);
  }

  .panel--campaign {
    background: var(--sand);
  }

  .panel--review {
    background: var(--mist);
  }

  .panel--lead {
    background: color-mix(in oklab, var(--allium) 24%, var(--white));
  }

  .panel__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.1rem;
    background: var(--white);
    border-radius: 999px;
    box-shadow: 0 10px 24px -18px color-mix(in oklab, var(--eggplant) 60%, transparent);
  }

  .panel__icon {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    color: var(--v3-text-low);
  }

  .panel__label {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-system);
    font-size: 0.92rem;
    color: var(--eggplant);
  }

  .panel__caret {
    width: 1px;
    height: 1em;
    background: var(--grape);
    animation: panel-caret-blink 1s step-end infinite;
  }

  @keyframes panel-caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .panel__head--notify {
    gap: 0.65rem;
  }

  .panel__notify-label {
    font-family: var(--font-product);
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--eggplant);
  }

  .panel__notify-meta {
    font-family: var(--font-system);
    font-size: 0.75rem;
    color: var(--v3-text-low);
  }

  .panel__pulse {
    position: relative;
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--grape);
  }

  .panel__pulse.is-pulsing::after {
    content: "";
    position: absolute;
    inset: -0.3rem;
    border-radius: 50%;
    border: 1px solid var(--grape);
    animation: panel-pulse-ring 1.4s ease-out infinite;
  }

  @keyframes panel-pulse-ring {
    0% { opacity: 0.9; transform: scale(0.6); }
    100% { opacity: 0; transform: scale(1.8); }
  }

  .panel__rows {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .panel__row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.85rem;
    border-radius: 6px;
  }

  .panel__row--primary {
    background: var(--white);
    box-shadow: 0 10px 24px -18px color-mix(in oklab, var(--eggplant) 60%, transparent);
  }

  .panel__row--ghost {
    background: color-mix(in oklab, var(--white) 55%, transparent);
  }

  .panel__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.3rem;
    height: 1.3rem;
    flex: none;
    border-radius: 50%;
    font-family: var(--font-system);
    font-size: 0.68rem;
    font-weight: 500;
  }

  .panel__row--primary .panel__badge {
    background: var(--grape);
    color: var(--white);
  }

  .panel__row--ghost .panel__badge {
    background: color-mix(in oklab, var(--eggplant) 10%, transparent);
    color: var(--v3-text-low);
  }

  .panel__badge--icon {
    width: 1.6rem;
    height: 1.6rem;
  }

  .panel__badge--icon svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .panel__thumb {
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    border-radius: 5px;
    background: var(--allium);
  }

  .panel__thumb--ghost {
    background: color-mix(in oklab, var(--eggplant) 10%, transparent);
  }

  .panel__lines {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .panel__name {
    font-family: var(--font-product);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--eggplant);
  }

  .panel__meta {
    font-family: var(--font-system);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--v3-text-low);
  }

  .panel__meta--done {
    color: var(--grape);
  }

  .panel__stars {
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    color: var(--eggplant);
  }

  .panel__quote {
    font-family: var(--font-product);
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--eggplant);
  }

  .panel__bar {
    height: 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--eggplant) 10%, transparent);
  }

  .panel__bar--wide {
    width: 85%;
  }

  .panel__bar--narrow {
    width: 55%;
  }

  @media (prefers-reduced-motion: reduce) {
    .panel__caret {
      animation: none;
      opacity: 0;
    }

    .panel__pulse.is-pulsing::after {
      animation: none;
      opacity: 0;
    }
  }

  /* One Guest. One History. */
  .history {
    background: var(--sand);
  }

  .history__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .record {
    background: var(--white);
    border-radius: 4px;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    font-family: var(--font-product);
  }

  .record__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--eggplant);
  }

  .record__meta {
    margin-top: 0.25rem;
    font-family: var(--font-system);
    font-size: 0.8rem;
    color: var(--v3-text-low);
  }

  .record__timeline {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  .record__timeline li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.2rem 1rem;
    padding: 0.85rem 0;
    border-top: 1px solid color-mix(in oklab, var(--eggplant) 10%, transparent);
  }

  .record__when {
    grid-row: span 2;
    font-family: var(--font-system);
    font-size: 0.78rem;
    color: var(--v3-text-low);
    padding-top: 0.15rem;
  }

  .record__what {
    font-weight: 600;
    color: var(--eggplant);
  }

  .record__detail {
    font-size: 0.9rem;
    color: var(--grape);
  }

  @media (max-width: 52rem) {
    .history__inner {
      grid-template-columns: 1fr;
    }
  }

  /* Chorus remembers the next step */
  .next__list {
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .next__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
    padding: clamp(1rem, 2.5vw, 1.5rem) 0;
    border-top: 1px solid color-mix(in oklab, var(--eggplant) 14%, transparent);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + 0.8vw, 1.5rem);
    letter-spacing: -0.01em;
  }

  .next__trigger {
    color: var(--v3-text-mid);
  }

  .next__arrow {
    color: var(--allium);
    text-align: center;
  }

  .next__action {
    font-weight: 700;
    color: var(--eggplant);
  }

  @media (max-width: 40rem) {
    .next__row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .next__arrow {
      display: none;
    }
  }

  /* Close */
  .close {
    background: var(--eggplant);
    color: var(--white);
  }

  .close__inner {
    text-align: center;
  }

  .close__title {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.6rem);
    letter-spacing: -0.035em;
