---
import Base from "../layouts/Base.astro";
import FeatureArt from "../components/FeatureArt.astro";

const topics = [
  "Menu", "Hours", "Reservations", "Policies", "Directions",
  "Private Events", "Catering", "Common Questions",
];

const scenarios = [
  {
    label: "Dinner rush",
    body: "The team can't answer. Host Helper can.",
  },
  {
    label: "After hours",
    body: "A guest calls late and still gets help.",
  },
  {
    label: "Private event",
    body: "A large-party inquiry is captured.",
  },
  {
    label: "Needs a human",
    body: "The call is routed to the right person.",
  },
];

const history = [
  { when: "7:42 PM", what: "Incoming call", detail: "Reservation request · party of 6" },
  { when: "7:42 PM", what: "Answered by AI Host Helper", detail: "Reservation information handled" },
  { when: "7:43 PM", what: "Reservation captured", detail: "Saturday · 7:30 PM · guest identified" },
  { when: "7:43 PM", what: "Conversation logged", detail: "Added to the guest's history" },
];
---

<Base
  title="AI Host Helper — Tempo Chorus"
  description="Tempo AI Host Helper answers when your team can't: during the rush, after hours and whenever the phone needs attention."
  active="ai-host-helper"
>
  <section class="lead">
    <div class="shell">
      <h1 class="lead__title">Your host stand could use another set of hands.</h1>
      <p class="lede lead__sub">
        Tempo AI Host Helper answers when your team can't, during the rush, after hours and whenever the
        phone needs attention.
      </p>
      <a class="btn lead__cta" href="#call-me">Have AI Host Helper call me</a>
    </div>
  </section>

  <section class="try" aria-labelledby="try-title">
    <div class="shell try__inner">
      <p class="eyebrow">Try asking it something.</p>
      <h2 class="section-title" id="try-title">A realistic guest call.</h2>
      <div class="exchange" aria-label="Example: a guest asks for a Saturday reservation and Host Helper handles it">
        <p class="exchange__guest">“Do you have anything for six Saturday around 7:30?”</p>
        <ul class="exchange__status">
          <li>Reservation information handled ✓</li>
          <li>Guest identified ✓</li>
          <li>Conversation logged ✓</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="topics" aria-labelledby="topics-title">
    <div class="shell">
      <p class="eyebrow">Built around your restaurant.</p>
      <h2 class="section-title" id="topics-title">Your menu. Your hours. Your policies.</h2>
      <ul class="topics__list">
        {topics.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="scenarios" aria-labelledby="scenarios-title">
    <div class="shell">
      <p class="eyebrow">Restaurant scenarios</p>
      <h2 class="section-title" id="scenarios-title">Every service, covered.</h2>
      <ol class="scenario-list">
        {scenarios.map((s) => (
          <li class="scenario">
            <p class="scenario__label">{s.label}</p>
            <p class="scenario__body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="history" aria-labelledby="history-title">
    <div class="shell history__inner">
      <div class="history__say">
        <p class="eyebrow">Know what happened.</p>
        <h2 class="section-title" id="history-title">Every call becomes part of the guest relationship.</h2>
        <p class="lede">
          AI Host Helper isn't a separate answering bot. Each conversation is logged in Chorus, next to the
          rest of the guest's history.
        </p>
      </div>
      <ol class="log" aria-label="Example call history in Chorus">
        {history.map((h) => (
          <li class="log__row">
            <span class="log__when">{h.when}</span>
            <span class="log__what">{h.what}</span>
            <span class="log__detail">{h.detail}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="call-me" id="call-me" aria-labelledby="call-me-title">
    <div class="shell call-me__inner">
      <div class="call-me__say">
        <p class="eyebrow">Hear it for yourself</p>
        <h2 class="section-title" id="call-me-title">Have AI Host Helper call you.</h2>
        <p class="lede">Give us your number and we'll call you back, usually within a few minutes.</p>
      </div>
      <div class="call-me__show">
        <FeatureArt kind="agent" />
      </div>
    </div>
  </section>
</Base>

<style>
  section {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .eyebrow {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--v3-text-low);
  }

  .section-title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.4rem);
    letter-spacing: -0.035em;
    color: var(--eggplant);
    max-width: 22ch;
  }

  .lede {
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    color: var(--v3-text-mid);
    max-width: 48ch;
  }

  .lead {
    padding-top: clamp(5rem, 12vw, 9rem);
    padding-bottom: clamp(3.5rem, 8vw, 5rem);
  }

  .lead__title {
    font-size: clamp(2.6rem, 1.2rem + 5.4vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--eggplant);
    max-width: 18ch;
  }

  .lead__sub {
    max-width: 46ch;
  }

  .lead__cta {
    margin-top: 2.25rem;
  }

  /* Try asking it something: one realistic exchange, product type. */
  .try__inner {
    max-width: 52rem;
  }

  .exchange {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--white);
    border-radius: 4px;
    font-family: var(--font-product);
  }

  .exchange__guest {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    line-height: 1.35;
    color: var(--eggplant);
  }

  .exchange__status {
    margin: 1.5rem 0 0;
    padding: 1.25rem 0 0;
    list-style: none;
    border-top: 1px solid color-mix(in oklab, var(--eggplant) 10%, transparent);
    display: grid;
    gap: 0.5rem;
    font-family: var(--font-system);
    font-size: 0.9rem;
    color: var(--grape);
  }

  /* Built around your restaurant: typographic, not cards. */
  .topics {
    background: var(--sand);
  }

  .topics__list {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.3rem);
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--eggplant);
  }

  .topics__list li:not(:last-child)::after {
    content: "·";
    margin-left: 1.5rem;
    color: var(--allium);
  }

  /* Restaurant scenarios: four short moments. */
  .scenario-list {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(2rem, 4vw, 3.5rem);
  }

  .scenario {
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in oklab, var(--eggplant) 14%, transparent);
  }

  .scenario__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
    color: var(--eggplant);
  }

  .scenario__body {
    margin-top: 0.5rem;
    color: var(--v3-text-mid);
    max-width: 36ch;
  }

  @media (max-width: 40rem) {
    .scenario-list {
      grid-template-columns: 1fr;
    }
  }

  /* Know what happened: call history in Chorus. */
  .history {
    background: var(--white);
  }

  .history__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .log {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--mist);
    border-radius: 4px;
    padding: clamp(1.25rem, 3vw, 2rem);
    font-family: var(--font-product);
  }

  .log__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.15rem 1rem;
    padding: 0.85rem 0;
    border-top: 1px solid color-mix(in oklab, var(--eggplant) 10%, transparent);
  }

  .log__row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .log__when {
    grid-row: span 2;
    font-family: var(--font-system);
    font-size: 0.78rem;
    color: var(--v3-text-low);
    padding-top: 0.15rem;
  }

  .log__what {
    font-weight: 600;
    color: var(--eggplant);
  }

  .log__detail {
    font-size: 0.9rem;
    color: var(--grape);
  }

  @media (max-width: 52rem) {
    .history__inner {
      grid-template-columns: 1fr;
    }
  }

  /* Call me: the live widget, unchanged. */
  .call-me {
    background: var(--eggplant);
    color: var(--white);
  }

  .call-me__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .call-me .eyebrow {
    color: var(--allium);
  }

  .call-me .section-title {
    color: var(--white);
  }

  .call-me .lede {
    color: color-mix(in oklab, var(--white) 75%, transparent);
  }

  @media (max-width: 52rem) {
    .call-me__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
