---
import Base from "../layouts/Base.astro";

const included = [
  "Chorus platform",
  "Guest marketing",
  "Reputation",
  "Guest relations",
  "Private events + catering",
  "Menus Made for the Web",
  "AI Host Helper*",
  "Tempo support",
];

const locations = [
  { label: "1 concept, 1 location", total: "$397" },
  { label: "1 concept, 3 locations", total: "$695" },
  { label: "1 concept, 5 locations", total: "$993" },
];

const concepts = [
  { label: "Concept A, 3 locations", detail: "$397 + $149 + $149", total: "$695" },
  { label: "Concept B, 1 location", detail: "$397", total: "$397" },
];
---

<Base
  title="Pricing — Tempo Chorus"
  description="Simple pricing that grows with you. Plans start at $397/month for your first concept and location, with $149/month for each additional location."
  active="pricing"
>
  <section class="lead">
    <div class="shell">
      <h1 class="lead__title">Simple pricing that grows with you.</h1>
      <p class="lede lead__sub">Start with your concept. Add locations as you grow.</p>
    </div>
  </section>

  <section class="plan" aria-labelledby="plan-title">
    <div class="shell plan__inner">
      <div class="plan__price">
        <p class="eyebrow" id="plan-title">First concept + first location</p>
        <p class="plan__amount">$397<span>/month</span></p>
        <a class="btn plan__cta" href="/book-a-demo">Book a Demo</a>
      </div>
      <ul class="plan__included">
        {included.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="locations" aria-labelledby="locations-title">
    <div class="shell">
      <p class="eyebrow">Additional locations</p>
      <h2 class="section-title" id="locations-title">+$149/month per additional location of the same concept.</h2>
      <ul class="math">
        {locations.map((l) => (
          <li class="math__row">
            <span class="math__label">{l.label}</span>
            <span class="math__total">{l.total}<span>/mo</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="brands" aria-labelledby="brands-title">
    <div class="shell brands__inner">
      <div class="brands__say">
        <p class="eyebrow">More than one restaurant brand?</p>
        <h2 class="section-title" id="brands-title">Each distinct concept starts its own Chorus subscription.</h2>
      </div>
      <ul class="math">
        {concepts.map((c) => (
          <li class="math__row">
            <span class="math__label">
              {c.label}
              <span class="math__detail">{c.detail}</span>
            </span>
            <span class="math__total">{c.total}<span>/mo</span></span>
          </li>
        ))}
        <li class="math__row math__row--total">
          <span class="math__label">Combined total</span>
          <span class="math__total">$1,092<span>/mo</span></span>
        </li>
      </ul>
    </div>
  </section>

  <section class="concept" aria-labelledby="concept-title">
    <div class="shell concept__inner">
      <p class="eyebrow">What's a concept?</p>
      <h2 class="section-title" id="concept-title">A concept is a distinct restaurant brand.</h2>
      <p class="lede">
        Three locations of the same restaurant are one concept with three locations. Two different restaurant
        brands are two concepts, even when they share the same ownership group.
      </p>
    </div>
  </section>

  <section class="onboarding" aria-labelledby="onboarding-title">
    <div class="shell onboarding__inner">
      <p class="eyebrow">White-glove onboarding</p>
      <h2 class="section-title" id="onboarding-title">$497 one-time.</h2>
      <p class="lede">
        Commit to the first three months of Chorus and the onboarding fee is waived. After the initial three
        months, Chorus continues month-to-month.
      </p>
      <a class="text-link" href="/book-a-demo">Book a Demo →</a>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="shell close__inner">
      <h2 class="close__title" id="close-title">See how Chorus could work for your restaurant.</h2>
      <a class="btn btn--light" href="/book-a-demo">Book a Demo</a>
      <p class="close__note">*AI Host Helper usage allowance to be confirmed before launch.</p>
    </div>
  </section>
</Base>

<style>
  section {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .eyebrow {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--v3-text-low);
  }

  .section-title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.4rem);
    letter-spacing: -0.035em;
    color: var(--eggplant);
    max-width: 24ch;
  }

  .lede {
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    color: var(--v3-text-mid);
    max-width: 50ch;
  }

  .text-link {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--eggplant);
    text-decoration: none;
    border-bottom: 2px solid var(--allium);
    padding-bottom: 0.15rem;
  }

  /* Lead */
  .lead {
    padding-top: clamp(5rem, 12vw, 9rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .lead__title {
    font-size: clamp(2.6rem, 1.2rem + 5.4vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--eggplant);
    max-width: 16ch;
  }

  /* The one price */
  .plan__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .plan__amount {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4rem, 2rem + 6vw, 7rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--eggplant);
  }

  .plan__amount span {
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
    letter-spacing: 0;
    color: var(--v3-text-mid);
  }

  .plan__cta {
    margin-top: 2rem;
  }

  .plan__included {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--eggplant);
    border-top: 2px solid var(--eggplant);
  }

  .plan__included li {
    padding: 0.95rem 0;
    border-bottom: 1px solid color-mix(in oklab, var(--eggplant) 12%, transparent);
  }

  @media (max-width: 52rem) {
    .plan__inner {
      grid-template-columns: 1fr;
    }
  }

  /* Shared math list */
  .locations {
    background: var(--sand);
  }

  .math {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }

  .math__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.1rem 0;
    border-top: 1px solid color-mix(in oklab, var(--eggplant) 14%, transparent);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    color: var(--eggplant);
  }

  .math__row:last-child {
    border-bottom: 1px solid color-mix(in oklab, var(--eggplant) 14%, transparent);
  }

  .math__detail {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-system);
    font-size: 0.8rem;
    color: var(--v3-text-low);
  }

  .math__total {
    font-weight: 700;
    white-space: nowrap;
  }

  .math__total span {
    font-weight: 500;
    color: var(--v3-text-low);
  }

  .math__row--total {
    border-top: 2px solid var(--eggplant);
  }

  /* Brands */
  .brands__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  @media (max-width: 52rem) {
    .brands__inner {
      grid-template-columns: 1fr;
    }
  }

  /* Concept + onboarding */
  /* Close */
  .close {
    background: var(--eggplant);
    color: var(--white);
  }

  .close__inner {
    text-align: center;
  }

  .close__title {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.6rem);
    letter-spacing: -0.035em;
    max-width: 22ch;
    margin: 0 auto;
    color: var(--white);
  }

  .close__inner .btn {
    margin-top: 2.25rem;
  }

  .close__note {
    margin-top: 2rem;
    font-size: 0.85rem;
    color: color-mix(in oklab, var(--white) 60%, transparent);
  }

  .btn--light {
    --btn-bg: var(--white);
    --btn-fg: var(--eggplant);
  }

  .btn--light:hover {
    --btn-bg: var(--allium);
  }
</style>
