---
import Base from "../layouts/Base.astro";

const included = [
  "Chorus Platform",
  "Guest Marketing",
  "Reputation Management",
  "Guest Recovery",
  "Google Business Profile Management",
  "Social Media Management",
  "AI Host Helper",
  "Tempo Support",
];

---

<Base
  title="Pricing — Tempo Chorus"
  description="Simple pricing that grows with you. Plans start at $397/month for your first concept and location, with $149/month for each additional location."
  active="pricing"
>
  <section class="lead">
    <div class="shell">
      <h1 class="lead__title">Simple pricing that grows with you.</h1>
    </div>
  </section>

  <section class="plan" aria-labelledby="plan-title">
    <div class="shell plan__inner">
      <div class="plan__price">
        <p class="eyebrow" id="plan-title">Single location</p>
        <p class="plan__amount">$397<span>/month</span></p>
        <a class="btn plan__cta" href="/book-a-demo">Book a Demo</a>
      </div>
      <ul class="plan__included">
        {included.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="onboarding" aria-labelledby="onboarding-title">
    <div class="shell onboarding__inner">
      <p class="eyebrow">White-glove onboarding</p>
      <h2 class="section-title" id="onboarding-title">Set up for your restaurant.</h2>
      <p class="lede">
        We'll configure Chorus, connect the essentials and guide your team through launch. Choose a
        three-month commitment and onboarding and we'll waive the one-time $500 fee!
      </p>
      <a class="text-link" href="/book-a-demo">Book a Demo →</a>
    </div>
  </section>

  <section class="managed" aria-labelledby="managed-title">
    <div class="shell">
      <div class="managed__inner">
        <div class="managed__say">
          <p class="eyebrow">Add-on · Tempo Managed Services</p>
          <h2 class="section-title" id="managed-title">Want us to run it for you?</h2>
          <p class="lede">
            Chorus gives your team the system. If you want more hands-on support, Tempo can build a custom
            service package to manage your marketing and operate Chorus for you.
          </p>
        </div>
        <ul class="managed__list">
          <li class="managed__item">
            <p class="managed__name">We build the plan.</p>
            <p class="managed__text">Marketing shaped around your restaurant, goals and calendar.</p>
          </li>
          <li class="managed__item">
            <p class="managed__name">We run the work.</p>
            <p class="managed__text">Campaigns, automations and guest follow-up handled for you.</p>
          </li>
          <li class="managed__item">
            <p class="managed__name">We keep improving.</p>
            <p class="managed__text">Ongoing support and adjustments as your business changes.</p>
          </li>
        </ul>
      </div>
      <p class="managed__note">Tempo Managed is a separately priced add-on and is not included with Chorus plans.</p>
      <a class="btn" href="/book-a-demo">Ask about Tempo Managed</a>
    </div>
  </section>

  <section class="website-addon" aria-labelledby="website-addon-title">
    <div class="shell">
      <div class="website-addon__inner">
        <div class="website-addon__say">
          <p class="eyebrow">Add-on · Website</p>
          <h2 class="section-title" id="website-addon-title">Need a new website too?</h2>
          <p class="lede">Add a custom restaurant website built around your brand and connected to Chorus.</p>
        </div>
        <ul class="website-addon__list">
          <li class="website-addon__item">
            <p class="website-addon__price">$600<span>one-time fee</span></p>
            <p class="website-addon__label">Website design and setup</p>
          </li>
          <li class="website-addon__item">
            <p class="website-addon__price">$15<span>per month</span></p>
            <p class="website-addon__label">Hosting and ongoing website service</p>
          </li>
        </ul>
      </div>
      <p class="website-addon__note">Already have a website? Keep it. Chorus works with that too.</p>
      <a class="btn" href="/book-a-demo">Add a Website</a>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="shell close__inner">
      <h2 class="close__title" id="close-title">See how Chorus could work for your restaurant.</h2>
      <a class="btn" href="/book-a-demo">Book a Demo</a>
    </div>
  </section>
</Base>

<style>
  section {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .eyebrow {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--v3-text-low);
  }

  .section-title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.4rem);
    letter-spacing: -0.035em;
    color: var(--eggplant);
    max-width: 24ch;
  }

  .lede {
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    color: var(--v3-text-mid);
    max-width: 50ch;
  }

  .text-link {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--eggplant);
    text-decoration: none;
    border-bottom: 2px solid var(--allium);
    padding-bottom: 0.15rem;
  }

  /* Lead */
  .lead {
    padding-top: clamp(5rem, 12vw, 9rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .lead__title {
    font-size: clamp(2.6rem, 1.2rem + 5.4vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--eggplant);
    max-width: 16ch;
  }

  /* The one price */
  .plan__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .plan__amount {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4rem, 2rem + 6vw, 7rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--eggplant);
  }

  .plan__amount span {
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
    letter-spacing: 0;
    color: var(--v3-text-mid);
  }

  .plan__cta {
    margin-top: 2rem;
  }

  .plan__included {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--eggplant);
  }

  .plan__included li {
    padding: 0.95rem 0;
    border-bottom: 1px solid color-mix(in oklab, var(--eggplant) 12%, transparent);
  }

  .plan__included li:first-child {
    font-weight: 700;
    text-transform: uppercase;
    border-bottom-width: 2px;
  }

  @media (max-width: 52rem) {
    .plan__inner {
      grid-template-columns: 1fr;
    }
  }

  /* Tempo Managed Services add-on */
  .managed {
    background: var(--sand);
  }

  .managed__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .managed__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .managed__item {
    padding: 1.1rem 0;
    border-top: 1px solid color-mix(in oklab, var(--eggplant) 14%, transparent);
  }

  .managed__item:last-child {
    border-bottom: 1px solid color-mix(in oklab, var(--eggplant) 14%, transparent);
  }

  .managed__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--eggplant);
  }

  .managed__text {
    margin-top: 0.3rem;
    color: var(--v3-text-mid);
  }

  .managed__note {
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: var(--v3-text-low);
  }

  .managed .btn {
    margin-top: 1.25rem;
  }

  @media (max-width: 52rem) {
    .managed__inner {
      grid-template-columns: 1fr;
    }
  }

  /* Website add-on */
  .website-addon__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .website-addon__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .website-addon__item {
    padding: 1.1rem 0;
    border-top: 1px solid color-mix(in oklab, var(--eggplant) 14%, transparent);
  }

  .website-addon__item:last-child {
    border-bottom: 1px solid color-mix(in oklab, var(--eggplant) 14%, transparent);
  }

  .website-addon__price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 1rem + 1vw, 1.7rem);
    letter-spacing: -0.02em;
    color: var(--eggplant);
  }

  .website-addon__price span {
    margin-left: 0.5rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--v3-text-low);
  }

  .website-addon__label {
    margin-top: 0.3rem;
    color: var(--v3-text-mid);
  }

  .website-addon__note {
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: var(--v3-text-low);
  }

  .website-addon .btn {
    margin-top: 1.25rem;
  }

  @media (max-width: 52rem) {
    .website-addon__inner {
      grid-template-columns: 1fr;
    }
  }

  /* Close */
  .close {
    background: var(--eggplant);
    color: var(--white);
  }

  .close__inner {
    text-align: center;
  }

  .close__title {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.6rem);
    letter-spacing: -0.035em;
    max-width: 22ch;
    margin: 0 auto;
    color: var(--white);
  }

  .close__inner .btn {
    margin-top: 2.25rem;
  }

  .close__note {
    margin-top: 2rem;
    font-size: 0.85rem;
    color: color-mix(in oklab, var(--white) 60%, transparent);
  }

</style>
