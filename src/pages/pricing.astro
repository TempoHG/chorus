---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";

const plan = {
  name: "Chorus",
  price: "$299",
  tagline: "Bring everything together.",
  includesLabel: "Includes",
  includes: [
    {
      name: "Website & lead capture",
      desc: "A restaurant-ready website with landing pages and lead-capture forms, built to turn visitors into guests — or we integrate with the site you already have.",
    },
    {
      name: "Restaurant Systems",
      desc: "Ready-to-use workflows for private events, catering, missed-call recovery, guest recovery, birthdays, VIPs, win-backs and more — configured for your restaurant, not built from scratch.",
    },
    {
      name: "Unified guest inbox",
      desc: "Phone, text, email, social messages and web chat, all answered from one place — nothing falls through the cracks between apps.",
    },
    {
      name: "Guest database & marketing",
      desc: "One record per guest, with email and SMS campaigns, offers and segmentation to bring them back.",
    },
    {
      name: "Reviews & reputation",
      desc: "Review requests sent at the right time, and every review centralized so responses actually happen.",
    },
    {
      name: "Automations & reporting",
      desc: "The repetitive follow-up, reminders and internal notifications run themselves, with reporting on what's working.",
    },
    {
      name: "Social planning",
      desc: "Plan, schedule and publish social content from the same place you manage everything else.",
    },
    {
      name: "White-glove onboarding, training and support",
      desc: "Restaurant-specific setup and team training to start, a support-ticket link inside Chorus, and ongoing updates after you're live.",
    },
  ],
};

const additionalLocationPrice = "+$149";

const addOns = [
  {
    name: "Local Presence",
    note: "Keep restaurant information accurate across major directories, maps and search destinations.",
  },
  {
    name: "Local SEO",
    note: "Add keyword research, SEO audits, optimization tools, local search insights and reporting.",
  },
  {
    name: "AI Restaurant Assistant",
    note: "Add AI-powered guest conversations and assistance across supported channels.",
  },
  {
    name: "AI Phone",
    note: "Answer calls, handle common questions and help guests when the restaurant team can't get to the phone.",
  },
  {
    name: "AI Web & Text Conversations",
    note: "Automatically handle common guest conversations through website chat and SMS.",
  },
  {
    name: "AI Review Responses",
    note: "Help generate and manage responses to guest reviews.",
  },
  {
    name: "AI Unlimited",
    note: "Increase AI capacity for restaurants with higher conversation or call volume.",
  },
  {
    name: "Dedicated Email",
    note: "Dedicated sending infrastructure for restaurants with higher-volume email programs.",
  },
  {
    name: "WhatsApp",
    note: "Add WhatsApp as another guest messaging channel where relevant.",
  },
];

const managed = [
  {
    name: "Managed Social Media",
    note: "Planning, content creation, scheduling and ongoing social management.",
  },
  {
    name: "Managed Email & SMS",
    note: "Campaign strategy, copy, calendar and execution.",
  },
  {
    name: "Managed Advertising",
    note: "Paid media creation, launch and optimization. Ad spend is separate.",
  },
  {
    name: "Managed SEO",
    note: "Strategy, optimization, content and ongoing search improvement.",
  },
  {
    name: "Website Design & Management",
    note: "Design, build and ongoing website management.",
  },
  {
    name: "Restaurant Marketing",
    note: "Broader outsourced strategy, creative, campaigns and execution.",
  },
];

const care = [
  "White-glove onboarding included with every plan.",
  "Restaurant-specific configuration, not an empty account.",
  "Essential workflows and campaigns configured during onboarding.",
  "Team training included.",
  "A support-ticket link inside Chorus, triaged to the right person.",
  "Ongoing platform updates and restaurant-specific improvements.",
];

const faqs = [
  {
    q: "How quickly will I see results?",
    a: "Most restaurants start seeing measurable wins inside the first 14 days — captured calls, fewer no-shows, and more 5-star reviews.",
  },
  {
    q: "Is there really no contract?",
    a: "Correct. Month-to-month. Cancel in one click. 14-day money-back guarantee if it's not a fit.",
  },
  {
    q: "Is there a free trial?",
    a: "We offer a free consultation for your restaurant, and may provide a free trial for certain offerings.",
  },
  {
    q: "How fast is setup, and when will my system go live?",
    a: "It typically goes live in 7–10 business days from the moment we receive all your onboarding requirements (brand assets, business info, integration credentials). Each launch includes automation workflows, a nurture email campaign, and AI caller + chatbot — all fully preconfigured and ready to take leads. If we're building your website too, we'll confirm your timeline after onboarding, but that's typically about 20 business days.",
  },
  {
    q: "Does this replace my POS or reservation system?",
    a: "No. It works alongside Toast, Square, Clover, Resy, OpenTable, Tock, and similar tools.",
  },
  {
    q: "What POS and reservation systems can you integrate with?",
    a: "Toast, Square, Clover, Lightspeed, Resy, OpenTable, and Tock via documented webhooks. Other systems can be connected through a custom build — we audit what you have on the demo call.",
  },
  {
    q: "What happens if I have an existing website?",
    list: [
      "You can keep it — we'll integrate into your current site.",
      "Or we can rebuild it on our platform (included).",
    ],
  },
  {
    q: "How does the AI caller work when we have a busy night?",
    a: "It answers every call on the second ring — even when every line is ringing and the floor is slammed. It books the table or captures the order, sends an SMS confirmation, and logs the call. Calls after close get answered too, instead of going to voicemail.",
  },
  {
    q: "Is the SMS automation TCPA and A2P 10DLC compliant?",
    a: "Yes. Every workflow ships with TCPA-correct opt-in language, STOP/HELP keyword routing, A2P 10DLC brand-and-campaign registration support, and audit-friendly opt-out logging. We have a compliance guide with this information.",
  },
  {
    q: "How is this different from a generic CRM or marketing toolkit?",
    a: "A CRM gives you a database. A toolkit gives you pieces to assemble yourself. Tempo Chorus is a done-for-you system with AI receptionist, industry-specific websites, prebuilt workflows, and AI-generated SEO content — all included and tuned for you, out of the box.",
  },
  {
    q: "What if I have multiple locations?",
    a: "Not a problem — we have configurations for multiple locations and franchises that make it easy to set up and manage all of your stores. Just give us a shout and we'll be glad to assist.",
  },
  {
    q: "Do you charge per location?",
    a: "Yes — $299/mo for the first location, then a flat $149/mo for each additional one. A few add-ons, like AI Unlimited and Local SEO, scale per location too — exact pricing gets confirmed on the demo call.",
  },
];
---

<Base
  title="Tempo Chorus pricing — one plan, complete platform"
  description="One plan at $299/mo — everything included, with a short list of add-ons for AI, advanced marketing and multi-location scale."
  active="pricing"
>
  <section class="lead">
    <div class="shell">
      <h1 class="lead__title">
        Simple pricing.<br />
        <span class="lead__accent">Complete platform.</span>
      </h1>
      <p class="lead__sub">
        One plan, complete on its own — not a stripped-down starter tier.
        Add exactly what you need, only when you need it.
      </p>
    </div>
  </section>

  <section class="tiers">
    <div class="shell">
      <div class="tier">
        <Wordmark height={40} class="tier__logo" />
        <p class="tier__tagline">{plan.tagline}</p>
        <div class="tier__top">
          <div class="tier__prices">
            <p class="tier__price">
              {plan.price}
              <span>/mo</span>
            </p>
            <p class="tier__price-extra">
              {additionalLocationPrice}<span>/mo</span> each additional location
            </p>
          </div>
          <a class="btn tier__cta" href="/#demo">Book a demo</a>
        </div>
        <p class="tier__includes-label">{plan.includesLabel}</p>
        <ul class="tier__list">
          {
            plan.includes.map((item) => (
              <li>
                <span class="dot" aria-hidden="true" />
                <div>
                  <p class="tier__item-name">{item.name}</p>
                  <p class="tier__item-desc">{item.desc}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="addons" aria-labelledby="addons-title">
    <div class="shell addons__grid">
      <div>
        <h2 class="eyeless-h2 addons__title" id="addons-title">
          Add more when you need it.
        </h2>
        <p class="lede addons__lede">
          Start with the complete Chorus platform. Add specialized
          capabilities when they make sense for your restaurant.
        </p>
      </div>
      <ul class="addons__list">
        {
          addOns.map((a) => (
            <li>
              <p class="addons__name">{a.name}</p>
              <p class="addons__note">{a.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="managed" aria-labelledby="managed-title">
    <div class="shell managed__inner">
      <div class="managed__say">
        <h2 class="eyeless-h2 managed__title" id="managed-title">
          Want us to do it for you?
        </h2>
        <p class="lede managed__lede">
          Chorus gives you the tools. Tempo can also provide the team.
        </p>
        <a
          class="hero__link"
          href="https://links.tempohg.com/widget/booking/hS2oh8e23QoVCAjR4WgK"
          target="_blank"
          rel="noopener"
        >
          Talk to us about managed services →
        </a>
      </div>
      <ul class="managed__list">
        {
          managed.map((m) => (
            <li>
              <span class="dot" aria-hidden="true" />
              <div>
                <p class="managed__item-name">{m.name}</p>
                <p class="managed__item-desc">{m.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="care" aria-labelledby="care-title">
    <div class="shell">
      <h2 class="eyeless-h2 care__title" id="care-title">
        Onboarding and support,<br /> on every plan.
      </h2>
      <ul class="care__list" data-reveal>
        {
          care.map((c, i) => (
            <li style={`--i:${i}`}>
              <span class="dot" aria-hidden="true" />
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="shell">
      <h2 class="eyeless-h2 faq__title" id="faq-title">Questions, answered.</h2>
      <div class="faq__list" data-reveal>
        {
          faqs.map((f, i) => (
            <details class="faq__item" style={`--i:${i}`}>
              <summary class="faq__q">
                {f.q}
                <span class="faq__toggle" aria-hidden="true" />
              </summary>
              <div class="faq__a">
                {f.list ? (
                  <ul class="faq__a-list">
                    {f.list.map((item) => (
                      <li>
                        <span class="dot" aria-hidden="true" />
                        {item}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p>{f.a}</p>
                )}
              </div>
            </details>
          ))
        }
      </div>
      <p class="faq__more">
        Still have questions? <a href="/#demo">Book a 30-minute demo</a> or email us.
      </p>
    </div>
  </section>

  <section class="close">
    <div class="shell close__inner">
      <h2 class="close__title">
        Not sure which features you need?<br />
        <span class="close__accent">We'll help you out.</span>
      </h2>
      <p class="close__sub">
        A personalized walkthrough, built around your restaurant — not a
        generic software tour.
      </p>
      <a class="btn" href="/#demo">Book a demo</a>
    </div>
  </section>
</Base>

<style>
  .lead {
    padding-block: clamp(4rem, 10vw, 7.5rem) clamp(3rem, 7vw, 5rem);
  }

  .lead__title {
    font-size: clamp(2.75rem, 1.1rem + 6vw, 5.6rem);
    letter-spacing: -0.045em;
  }

  .lead__accent {
    color: var(--mint-400);
  }

  .lead__sub {
    margin-top: 1.75rem;
    max-width: 58ch;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    line-height: 1.5;
    color: var(--text-mid);
  }

  /* ---------- Tiers ---------- */

  .tiers {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(4.5rem, 10vw, 8rem);
  }

  .tier {
    position: relative;
    max-width: 54rem;
    margin-inline: auto;
    background: var(--ink-700);
    border: 1px solid color-mix(in oklab, var(--violet-500) 30%, transparent);
    border-radius: 5px;
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: 0 18px 38px -24px rgb(0 0 0 / 0.9);
  }

  .tier__logo {
    display: block;
  }

  .tier__tagline {
    margin-top: 0.75rem;
    color: var(--text-mid);
  }

  .tier__top {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .tier__prices {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .tier__price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.6rem;
    letter-spacing: -0.04em;
    color: var(--mint-300);
  }

  .tier__price span {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-low);
  }

  .tier__price-extra {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-mid);
  }

  .tier__price-extra span {
    font-weight: 500;
    color: var(--text-low);
  }

  .tier__cta {
    padding-inline: 2rem;
  }

  .tier__includes-label {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 22%, transparent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-low);
  }

  .tier__list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.35rem 2rem;
  }

  .tier__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .tier__list .dot {
    margin-top: 0.55em;
    color: var(--mint-400);
  }

  .tier__item-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--text-hi);
  }

  .tier__item-desc {
    margin-top: 0.3rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-mid);
  }

  @media (max-width: 40rem) {
    .tier__list {
      grid-template-columns: 1fr;
    }

    .tier__top {
      flex-direction: column;
      align-items: flex-start;
    }

    .tier__cta {
      width: 100%;
      justify-content: center;
    }
  }

  /* ---------- Add-ons ---------- */

  .addons {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .addons__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .addons__lede {
    margin-top: 1.25rem;
    color: var(--text-low);
  }

  .addons__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .addons__list li {
    padding-block: 1.25rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 20%, transparent);
  }

  .addons__list li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .addons__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-hi);
  }

  .addons__note {
    margin-top: 0.3rem;
    color: var(--text-mid);
    font-size: 0.9rem;
    max-width: 46ch;
  }

  @media (max-width: 56rem) {
    .addons__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Managed services ---------- */

  .managed {
    padding-block: clamp(4.5rem, 10vw, 8rem);
    background: var(--ink-800);
  }

  .managed__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .managed__lede {
    margin-top: 1.25rem;
    color: var(--text-mid);
    max-width: 46ch;
  }

  .managed__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .managed__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .managed__list .dot {
    margin-top: 0.55em;
    color: var(--violet-400);
  }

  .managed__item-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-hi);
  }

  .managed__item-desc {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-mid);
  }

  .hero__link {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--violet-400);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--violet-400) 45%, transparent);
    padding-bottom: 2px;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .hero__link:hover {
    color: var(--text-hi);
    border-bottom-color: var(--text-hi);
  }

  @media (max-width: 56rem) {
    .managed__inner {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Care ---------- */

  .care {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .care__list {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem clamp(2rem, 6vw, 5rem);
  }

  .care__list li {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    padding-block: 0.6rem;
    color: var(--text-hi);
    font-size: 1.02rem;
  }

  .care__list .dot {
    color: var(--mint-400);
  }

  @media (max-width: 56rem) {
    .care__list {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- FAQ ---------- */

  .faq {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .faq__list {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    max-width: 52rem;
  }

  .faq__item {
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 20%, transparent);
  }

  .faq__item:first-child {
    border-top: 0;
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.35rem;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.02rem, 0.98rem + 0.3vw, 1.15rem);
    color: var(--text-hi);
    transition: color 0.2s var(--ease-out);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--mint-300);
  }

  .faq__toggle {
    position: relative;
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .faq__toggle::before,
  .faq__toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 0.25s var(--ease-out);
  }

  .faq__toggle::before {
    width: 100%;
    height: 1.5px;
  }

  .faq__toggle::after {
    width: 1.5px;
    height: 100%;
  }

  .faq__item[open] .faq__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg) scaleY(0);
  }

  .faq__a {
    padding-bottom: 1.5rem;
    padding-right: clamp(0rem, 4vw, 3rem);
    color: var(--text-mid);
    font-size: 0.98rem;
    line-height: 1.62;
    max-width: 62ch;
  }

  .faq__a-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .faq__a-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .faq__a-list .dot {
    color: var(--mint-400);
  }

  .faq__more {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 26%, transparent);
    max-width: 52rem;
    color: var(--text-mid);
  }

  .faq__more a {
    font-weight: 600;
    color: var(--violet-400);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--violet-400) 45%, transparent);
    padding-bottom: 1px;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .faq__more a:hover {
    color: var(--text-hi);
    border-bottom-color: var(--text-hi);
  }

  /* ---------- Close ---------- */

  .close {
    padding-block: clamp(4.5rem, 10vw, 8rem);
    background: var(--ink-800);
  }

  .close__title {
    font-size: clamp(2.1rem, 1.1rem + 3.2vw, 3.5rem);
    letter-spacing: -0.04em;
  }

  .close__accent {
    color: var(--mint-400);
  }

  .close__sub {
    margin-top: 1.6rem;
    max-width: 56ch;
    color: var(--text-mid);
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
  }

  .close__inner .btn {
    margin-top: 2.4rem;
  }
</style>
