---
import Base from "../layouts/Base.astro";

/* "Chorus in Action" — editorial copy only. The outcome of each moment now
   lives entirely inside its product demonstration (see the markup below),
   per the brief: no outcome appears in both the copy and the UI. */
const moments = [
  { label: "Dinner rush", title: "The phone rings.", body: "Your host is taking care of the guests in front of them." },
  { label: "After hours", title: "A private-event inquiry comes in.", body: "42 guests. December 14. Private dining." },
  { label: "After the visit", title: "A guest leaves a great review.", body: "Automate the response—or escalate it when a personal touch matters." },
  { label: "90 days later", title: "A regular hasn't been back.", body: "Chorus remembers. Automate the win-back—or alert your team when a personal invitation could make the difference." },
];

const systems = [
  {
    name: "Guest Relations",
    body: "Make the first impression feel as considered as the experience inside.",
    items: "Menus, hours, events, reservations and everything guests need—clear, current and easy to find.",
  },
  {
    name: "Guest Marketing",
    body: "Give guests a reason to come back.",
    items: "Email, text, social, birthdays, promotions and win-back campaigns.",
  },
  {
    name: "Reputation",
    body: "Build it. Protect it.",
    items: "Generate more reviews, manage responses and catch poor experiences while there's still an opportunity to recover the guest.",
  },
  {
    name: "Opportunities",
    body: "Don't let good leads disappear.",
    items: "Capture and follow up on private events, catering and other valuable inquiries.",
  },
];

const sites = [
  {
    name: "Citria Coastal Grill",
    domain: "citria.net",
    desc: "Mediterranean fine dining",
    src: "/img/home/site-citria-homepage.jpg",
    alt: "Citria Coastal Grill's homepage hero: an oceanview patio table set for dinner at sunset.",
  },
  {
    name: "Lou Amari's",
    domain: "louamaris.com",
    desc: "Neighborhood Italian restaurant",
    src: "/img/home/site-lou-amaris-homepage.jpg",
    alt: "Lou Amari's homepage hero: the restaurant's brick storefront lit up at night.",
  },
  {
    name: "Da Wurst",
    domain: "eatdawurst.com",
    desc: "Fast casual restaurant & bar",
    src: "/img/home/site-da-wurst-homepage.jpg",
    alt: "Da Wurst's homepage hero: a lively string-lit beer garden patio at night.",
  },
];
---

<Base
  title="Tempo Chorus — More guests. More often."
  description="Everything your restaurant needs to get found, get chosen and bring guests back."
  active="home"
>
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <img src="/img/home/hero-service-duotone.jpg" alt="" decoding="async" fetchpriority="high" />
    </div>
    <div class="shell hero__inner">
      <div class="hero__copy">
      <h1 class="hero__title">More guests.<br />More often.</h1>
      <p class="hero__sub">Everything your restaurant needs to get found, get chosen and bring guests back.</p>
      <div class="hero__actions">
        <a class="btn" href="/book-a-demo">Book a Demo</a>
        <a class="hero__link" href="#promise">See how Chorus works ↓</a>
      </div>
      </div>

      <div class="call" aria-label="Example: an incoming call is answered and a reservation is captured">
        <p class="call__head"><span class="call__dot" aria-hidden="true"></span>Incoming call · 7:42 PM</p>
        <p class="call__quote">“Do you have anything for six Saturday around 7:30?”</p>
        <p class="call__step call__step--1">AI Host Helper answered ✓</p>
        <p class="call__step call__step--2">Reservation captured ✓</p>
      </div>
    </div>
  </section>

  <section class="promise" id="promise" aria-labelledby="promise-title">
    <div class="shell">
      <h2 class="section-title" id="promise-title">Get found. Get chosen. Get them back.</h2>
      <ol class="journey">
        <li class="journey__step">
          <p class="journey__label">Get found</p>
          <p class="journey__head">Be there when guests are looking.</p>
          <p class="journey__body">Website. Menus. Google. Social. Advertising. Make it easier for new guests to discover your restaurant.</p>
        </li>
        <li class="journey__step">
          <p class="journey__label">Get chosen</p>
          <p class="journey__head">Turn interest into a visit.</p>
          <p class="journey__body">Calls. Reservations. Private events. Catering. Guest questions. Capture the opportunities your restaurant is already creating.</p>
        </li>
        <li class="journey__step">
          <p class="journey__label">Get them back</p>
          <p class="journey__head">The first visit shouldn't be the last.</p>
          <p class="journey__body">Reviews. Email. Text. Birthdays. Promotions. Guest recovery. Give guests reasons to return.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="operating" aria-labelledby="operating-title">
    <div class="shell">
      <h2 class="section-title" id="operating-title">While you're running the restaurant, Chorus is doing this.</h2>
      <div class="operating__layout">
      <figure class="operating__photo">
        <img src="/img/home/guest-marketing-server.jpg" alt="A server setting the table with tea service in a warm, busy dining room." loading="lazy" decoding="async" />
      </figure>
      <ol class="moments">
        <li class="moment">
          <div class="moment__intro">
            <p class="moment__label">
              <svg class="moment__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
              </svg>
              {moments[0].label}
            </p>
            <div class="moment__story">
              <p class="moment__title">{moments[0].title}</p>
              <p class="moment__text">{moments[0].body}</p>
            </div>
          </div>
          <div class="moment__demo">
            <div class="demo demo--call" data-moment-demo>
              <p class="demo__meta"><span class="demo__pulse" aria-hidden="true"></span>Incoming call · 7:42 PM</p>
              <p class="demo__quote" data-demo-step>"Do you have anything for six Saturday around 7:30?"</p>
              <p class="demo__processing" data-demo-step><span class="demo__label">AI Host Helper</span> Checking availability…</p>
              <div class="demo__detail" data-demo-step>
                <p>Saturday · 7:30 PM</p>
                <p>Party of 6</p>
              </div>
              <p class="demo__outcome" data-demo-step>Reservation captured <span aria-hidden="true">✓</span></p>
            </div>
          </div>
        </li>

        <li class="moment">
          <div class="moment__intro">
            <p class="moment__label">
              <svg class="moment__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              {moments[1].label}
            </p>
            <div class="moment__story">
              <p class="moment__title">{moments[1].title}</p>
              <p class="moment__text">{moments[1].body}</p>
            </div>
          </div>
          <div class="moment__demo">
            <div class="demo demo--event" data-moment-demo>
              <p class="demo__meta" data-demo-step>New private event</p>
              <div class="demo__body" data-demo-step>
                <p class="demo__name">Sarah Mitchell</p>
                <p class="demo__name-sub">Holiday Dinner</p>
                <div class="demo__detail">
                  <p>Dec 14 · 42 guests</p>
                  <p>6:30 PM · Private dining</p>
                </div>
              </div>
              <p class="demo__outcome" data-demo-step>Manager notified <span aria-hidden="true">✓</span></p>
              <p class="demo__outcome" data-demo-step>Follow-up scheduled <span aria-hidden="true">✓</span></p>
            </div>
          </div>
        </li>

        <li class="moment">
          <div class="moment__intro">
            <p class="moment__label">
              <svg class="moment__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M12 2.5l3.09 6.26L22 9.77l-5 4.87L18.18 21.5 12 18.27 5.82 21.5 7 14.64l-5-4.87 6.91-1.01Z" />
              </svg>
              {moments[2].label}
            </p>
            <div class="moment__story">
              <p class="moment__title">{moments[2].title}</p>
              <p class="moment__text">{moments[2].body}</p>
            </div>
          </div>
          <div class="moment__demo">
            <div class="demo demo--review" data-moment-demo>
              <p class="demo__stars" data-demo-step aria-label="5 out of 5 stars">★★★★★</p>
              <p class="demo__quote" data-demo-step>"Great dinner. Our server was fantastic and the food was excellent."</p>
              <p class="demo__source">Sarah M. · Google</p>
              <p class="demo__outcome" data-demo-step>Response ready <span aria-hidden="true">✓</span></p>
            </div>
          </div>
        </li>

        <li class="moment">
          <div class="moment__intro">
            <p class="moment__label">
              <svg class="moment__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="M22 6.5 12 13 2 6.5" />
              </svg>
              {moments[3].label}
            </p>
            <div class="moment__story">
              <p class="moment__title">{moments[3].title}</p>
              <p class="moment__text">{moments[3].body}</p>
            </div>
          </div>
          <div class="moment__demo">
            <div class="demo demo--winback" data-moment-demo>
              <p class="demo__meta">Sarah Mitchell</p>
              <ul class="demo__timeline" data-demo-step>
                <li>Apr 12 · Dinner</li>
                <li>May 03 · Dinner</li>
                <li>Jun 18 · Dinner</li>
                <li>Jul 08 · Dinner</li>
              </ul>
              <p class="demo__threshold" data-demo-step>90 days</p>
              <div class="demo__winback" data-demo-step>
                <p class="demo__name-sub">Haven't seen you lately</p>
                <p class="demo__quote">Come back this week and let us take care of dinner.</p>
              </div>
              <p class="demo__outcome" data-demo-step>Win-back sent <span aria-hidden="true">✓</span></p>
              <p class="demo__outcome demo__outcome--final" data-demo-step>Oct 12 · Reservation <span aria-hidden="true">✓</span></p>
            </div>
          </div>
        </li>
      </ol>
      </div>
    </div>
  </section>

  <section class="system" aria-labelledby="system-title">
    <div class="shell">
      <h2 class="section-title" id="system-title">One system. A lot less to manage.</h2>
      <ul class="system__list">
        {systems.map((s) => (
          <li class="system__item">
            <p class="system__name">{s.name}</p>
            <p class="system__head">{s.body}</p>
            <p class="system__body">{s.items}</p>
          </li>
        ))}
      </ul>
      <a class="text-link" href="/product">Explore Chorus →</a>
    </div>
  </section>

  <section class="websites" aria-labelledby="websites-title">
    <div class="shell">
      <h2 class="section-title" id="websites-title">One system.<br />No templates.</h2>
      <p class="lede">Your restaurant doesn't look like every other restaurant.<br class="lede__break" /> Your website shouldn't either.</p>
      <ul class="websites__grid">
        {sites.map((s) => (
          <li class="websites__item">
            <a class="websites__frame" href={`https://${s.domain}`} target="_blank" rel="noopener noreferrer" aria-label={`Visit the ${s.name} website (opens in a new tab)`}>
              <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
            </a>
            <p class="websites__name">{s.name}</p>
            <p class="websites__desc">{s.desc}</p>
          </li>
        ))}
      </ul>
      <p class="websites__note">Already have a website? Keep it. Chorus works with that too.</p>
      <a class="text-link" href="/websites">See our websites →</a>
    </div>
  </section>

  <section class="scale" aria-labelledby="scale-title">
    <div class="shell">
      <h2 class="section-title" id="scale-title">Built for restaurants. Built to grow.</h2>
      <p class="lede">Whether you're running one restaurant, adding locations or managing several restaurant concepts, Chorus can grow with you.</p>
      <p class="scale__path" aria-label="One restaurant, then one concept with multiple locations, then a restaurant group">
        <span>One restaurant</span><span aria-hidden="true">→</span><span>One concept, multiple locations</span><span aria-hidden="true">→</span><span>Multi-concept group</span>
      </p>
      <div class="scale__tempo">
        <p>And Tempo comes with it.</p>
        <ul>
          <li>We set it up. Around your restaurant.</li>
          <li>We train your team. On what they actually need.</li>
          <li>We keep helping. You're not handed a login and left to figure it out.</li>
        </ul>
      </div>
      <p class="scale__price">Plans start at <strong>$397/month</strong>.</p>
      <a class="text-link" href="/pricing">See pricing →</a>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="shell close__inner">
      <p class="close__kicker">All Together Now.</p>
      <h2 class="close__title" id="close-title">Your website. Your phone. Your marketing. Your guests.</h2>
      <p class="close__sub">One connected system built around your restaurant.</p>
      <a class="btn" href="/book-a-demo">Book a Demo</a>
    </div>
  </section>
</Base>

<style>

  .section-title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.6rem);
    letter-spacing: -0.035em;
    color: var(--eggplant);
    max-width: 22ch;
  }

  .lede {
    margin-top: 1.25rem;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    color: var(--v3-text-mid);
    max-width: 52ch;
  }

  .lede__break {
    display: inline;
  }

  @media (max-width: 40rem) {
    .lede__break {
      display: none;
    }
  }

  .text-link {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--eggplant);
    text-decoration: none;
    border-bottom: 2px solid var(--allium);
    padding-bottom: 0.15rem;
  }

  .text-link:hover {
    color: var(--grape);
  }

  section {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  /* 01 — Hero: type-only, one interaction as the product evidence. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(4.5rem, 12vw, 9rem);
    padding-bottom: clamp(4rem, 9vw, 6rem);
    background: var(--grape);
    color: var(--white);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero__title {
    color: var(--white);
    font-size: clamp(3rem, 1.2rem + 7vw, 6.8rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero__sub {
    margin-top: 1.75rem;
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.45rem);
    color: color-mix(in oklab, var(--white) 88%, transparent);
    max-width: 36ch;
  }

  .hero__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .hero__link {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
    border-bottom: 2px solid var(--allium);
    padding-bottom: 0.15rem;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  @media (max-width: 52rem) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }

  .call {
    max-width: 30rem;
    justify-self: end;
    width: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--mist);
    border: 1px solid color-mix(in oklab, var(--eggplant) 8%, transparent);
    border-radius: 8px;
    font-family: var(--font-product);
    animation: call-in 0.7s var(--ease-out) both;
  }

  .call__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-system);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--v3-text-low);
  }

  .call__dot {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--allium);
    animation: call-pulse 1.8s ease-out infinite;
  }

  .call__quote {
    margin-top: 0.85rem;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    color: var(--eggplant);
    line-height: 1.4;
    animation: call-quote 9s var(--ease-out) infinite;
  }

  .call__step {
    margin-top: 0.9rem;
    font-family: var(--font-system);
    font-size: 0.85rem;
    color: var(--grape);
    opacity: 0;
    animation: call-step-1 9s var(--ease-out) infinite;
  }

  .call__step--2 {
    animation-name: call-step-2;
  }

  @keyframes call-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes call-quote {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    6%,
    88% {
      opacity: 1;
      transform: translateY(0);
    }
    96%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }

  @keyframes call-step-1 {
    0%,
    14% {
      opacity: 0;
      transform: translateY(8px);
    }
    20%,
    88% {
      opacity: 1;
      transform: translateY(0);
    }
    96%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }

  @keyframes call-step-2 {
    0%,
    25% {
      opacity: 0;
      transform: translateY(8px);
    }
    31%,
    88% {
      opacity: 1;
      transform: translateY(0);
    }
    96%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }

  @keyframes call-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--allium) 60%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .call,
    .call__quote,
    .call__step {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .call__dot {
      animation: none;
    }
  }

  /* 02 — The promise: one continuous journey, not three cards. */
  .journey {
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    border-top: 2px solid var(--eggplant);
    padding-top: 2rem;
  }

  .journey__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--grape);
  }

  .journey__head {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 1rem + 1vw, 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--eggplant);
  }

  .journey__body {
    margin-top: 0.9rem;
    color: var(--v3-text-mid);
  }

  @media (max-width: 52rem) {
    .journey {
      grid-template-columns: 1fr;
    }
  }

  /* 03 — Chorus in Action: four restaurant moments, each paired with a
     compact product demonstration that shows Chorus reaching the outcome
     instead of a checkmark list repeating it. Rows stay hairline-separated
     and typographic — the grid below is the brief's 20/32/48 desktop split
     (moment label / restaurant story / demonstration); mobile stacks the
     same three pieces in reading order per row. */
  .operating {
    background: var(--white);
  }

  .operating__layout {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .operating__photo {
    margin: 0;
    position: sticky;
    top: 7rem;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .operating__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 52rem) {
    .operating__layout {
      grid-template-columns: 1fr;
    }

    .operating__photo {
      position: static;
      aspect-ratio: 16 / 10;
    }
  }

  .moments {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moment {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: clamp(2rem, 4.5vw, 3rem);
    border-top: 1px solid color-mix(in oklab, var(--eggplant) 14%, transparent);
  }

  /* Label and headline stack in one left-aligned column — the headline
     sits flush under its eyebrow rather than beside it in its own column. */
  .moment__intro {
    display: grid;
    gap: 0.6rem;
  }

  .moment__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-system);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--v3-text-low);
  }

  .moment__icon {
    display: block;
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    color: var(--grape);
  }

  .moment__title {
    font-family: var(--font-display);
    font-weight: 700;
