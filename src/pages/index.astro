---
import Base from "../layouts/Base.astro";
import PhoneField from "../components/PhoneField.astro";
import ProductMocks from "../components/ProductMocks.astro";
import FeatureArt from "../components/FeatureArt.astro";
import JobIcon from "../components/JobIcon.astro";

// GoHighLevel booking calendar, served from the Tempo whitelabel domain — NOT
// api.leadconnectorhq.com, which does not serve this calendar. WIDGET_ID is the
// id GHL's form_embed.js looks for when it posts the resize message back, so it
// must stay exactly as GHL generated it. The widget's own look is set in GHL
// (Calendars → Customise), not here; this page only frames it.
const GHL_DOMAIN = "https://links.tempohg.com";
const CALENDAR_ID = "I5Q7FwuP2H7GVLaL1Cai";
const WIDGET_ID = "yVHkwu10vymju35mIkBW_1786414705061";

const jobs = [
  {
    name: "Get Found",
    line: "Help more guests discover and choose the restaurant.",
    mark: "found",
  },
  {
    name: "Stay Connected",
    line: "Make it easier for guests to reach the restaurant, and the team to respond.",
    mark: "connected",
  },
  {
    name: "Bring Guests Back",
    line: "Build repeat visits and stronger relationships.",
    mark: "back",
  },
  {
    name: "Save Time",
    line: "Automate the repetitive marketing and communication work.",
    mark: "time",
  },
];

const vignettes = [
  {
    marker: "11:47 PM · Tuesday",
    trigger: "The phone rings twenty minutes after you locked the door.",
    response:
      "Tempo Chorus picks up, answers the question about Saturday, holds a table for six, and texts the confirmation before they've put the phone down.",
    weight: "wide",
    media: { type: "image", src: "/img/vignettes/closed.jpg", alt: "A \"Closed\" sign hanging in a restaurant's front window at night." },
  },
  {
    marker: "9:12 AM · Sunday",
    trigger: "Someone messages your Facebook page asking if you do gluten-free.",
    response:
      "Tempo Chorus answers in the same minute, in your words, and drops the conversation into the same place as every call and text.",
    weight: "normal",
    media: { type: "image", src: "/img/vignettes/glutenfree.jpg", alt: "A guest checking their phone for a reply." },
  },
  {
    marker: "Table 14 · 9:40 PM",
    trigger: "Four people just had the best meal they've had all month.",
    response:
      "The next morning Tempo Chorus thanks them and asks for the review — while it's still the best meal they've had all month.",
    weight: "normal",
    media: { type: "video", src: "/video/vignettes/bestmeal.mp4" },
  },
  {
    marker: "Last visit · 11 March",
    trigger: "A regular quietly stopped being a regular. Nobody noticed.",
    response:
      "Tempo Chorus noticed, and reached out with the kind of message that sounds like it came from you — because you wrote it once, and it's been waiting.",
    weight: "wide",
    media: { type: "image", src: "/img/vignettes/missingregular.jpg", alt: "An empty seat at a restaurant counter." },
  },
  {
    marker: "Inquiry · 40 people, December",
    trigger: "A private event lead lands while you're on the line.",
    response:
      "Tempo Chorus captures it, replies immediately, and keeps politely following up until a human on your side picks it up.",
    weight: "normal",
    media: { type: "image", src: "/img/vignettes/privateevent.jpg", alt: "A group celebrating together at a private event." },
  },
  {
    marker: "Birthday · in 3 days",
    trigger: "A regular's birthday is coming up, and nobody was going to mention it.",
    response:
      "Tempo Chorus already knows the date. The invitation goes out on time, personalized, without anyone adding it to a list.",
    weight: "normal",
    media: { type: "video", src: "/video/vignettes/birthday.mp4" },
  },
];

const systems = [
  { name: "Private Events", benefit: "Capture inquiries, respond immediately, organize opportunities, automate follow-up and keep every potential event moving toward a booking." },
  { name: "Catering", benefit: "Capture catering leads, qualify requests, track follow-up and keep opportunities organized." },
  { name: "Missed Call Recovery", benefit: "Automatically start a text conversation when the restaurant cannot answer." },
  { name: "Guest Reviews", benefit: "Request reviews at the right time, centralize review activity and make responses easier." },
  { name: "Guest Recovery", benefit: "Route negative feedback to the right person and create a consistent recovery process." },
  { name: "Birthday & Celebrations", benefit: "Collect important dates and automate timely, personalized reasons to return." },
  { name: "Guest Win-Back", benefit: "Reconnect with guests who have not visited recently." },
  { name: "VIP & Regulars", benefit: "Segment and communicate differently with the restaurant's most valuable guests." },
  { name: "Restaurant Events", benefit: "Promote special dinners, tastings, live music, holiday events and other experiences." },
  { name: "Hiring", benefit: "Collect applications, organize candidates, schedule interviews and automate candidate communication." },
  { name: "Donation Requests", benefit: "Collect and route community/donation requests through a consistent process." },
  { name: "Guest Inquiries", benefit: "Bring website, social, text and other inquiries into a more manageable workflow." },
];

const care = [
  "Restaurant-specific setup, not an empty account.",
  "White-glove onboarding and essential workflows configured for you.",
  "Team training, so everyone actually uses it.",
  "A support-ticket link inside Chorus, triaged to the right person.",
  "Ongoing platform updates and restaurant-specific improvements.",
];

const plan = {
  name: "Chorus",
  price: "$299",
  note: "One complete platform. Add AI, deeper marketing tools or extra locations as you grow.",
};
---

<Base
  title="Tempo Chorus — everything working together"
  description="Tempo Chorus brings your restaurant's marketing, guest communication, reputation, customer relationships and automation into one connected platform. Book a demo."
  active="home"
>
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__say">
        <h1 class="hero__title">
          Everything <span class="hero__accent">working together.</span>
        </h1>
        <p class="hero__sub">
          <strong>Tempo Chorus is one platform for everything your restaurant
          says to guests.</strong> Marketing, guest communication, reputation,
          customer relationships and automation — brought into one connected
          system, instead of a different tool for each.
        </p>
        <div class="hero__actions">
          <a class="btn" href="#demo">Book a demo</a>
          <a class="hero__link" href="#mocks">See how it works</a>
        </div>
      </div>
      <div class="hero__show">
        <PhoneField />
      </div>
    </div>
    <div class="hero__floor" />
  </section>

  <section class="jobs" aria-labelledby="jobs-title">
    <video
      class="jobs__bg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    >
      <source src="/video/four-jobs-bg.mp4" type="video/mp4" />
    </video>
    <div class="jobs__veil" aria-hidden="true"></div>
    <div class="shell jobs__shell">
      <h2 class="eyeless-h2 jobs__title" id="jobs-title">Four jobs. One platform.</h2>
      <div class="jobs__grid" data-reveal>
        {
          jobs.map((j, i) => (
            <article class="job" style={`--i:${i}`}>
              <span class="job__mark" aria-hidden="true">
                <JobIcon name={j.mark} />
              </span>
              <h3 class="job__name">{j.name}</h3>
              <p class="job__line">{j.line}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="chain" aria-labelledby="chain-title">
    <div class="shell">
      <h2 class="eyeless-h2 chain__title" id="chain-title">
        Here is what that<br /> actually means.
      </h2>
      <p class="lede chain__lede">
        Not features. Ordinary moments in a Tuesday.
      </p>
    </div>

    <div class="shell chain__list">
      <div class="chain__spine" aria-hidden="true"></div>
      {
        vignettes.map((v) => (
          <article class={`vignette vignette--${v.weight}`}>
            <div class="vignette__say">
              <h3 class="vignette__trigger">{v.trigger}</h3>
              <p class="vignette__marker">{v.marker}</p>
              <div class="vignette__rule" aria-hidden="true"></div>
              <p class="vignette__response">
                <span class="dot" aria-hidden="true" />
                <span>{v.response}</span>
              </p>
            </div>
            <div class="vignette__media">
              {v.media.type === "video" ? (
                <video
                  class="vignette__asset"
                  src={v.media.src}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-hidden="true"
                />
              ) : (
                <img
                  class="vignette__asset"
                  src={v.media.src}
                  alt={v.media.alt}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="vignette__veil" aria-hidden="true"></span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="shell chain__coda">
      <p>
        None of those is a big moment. That is exactly the point — they are the
        small ones, and they are the ones that get dropped.
      </p>
    </div>
  </section>

  <ProductMocks />

  <section class="systems" aria-labelledby="systems-title">
    <div class="shell">
      <h2 class="eyeless-h2 systems__title" id="systems-title">
        Restaurant Systems, not software features.
      </h2>
      <p class="lede systems__lede">
        Ready-to-use workflows built into every plan.
      </p>
      <ul class="systems__list" data-reveal>
        {
          systems.map((s, i) => (
            <li class="system" style={`--i:${i}`}>
              <span class="dot" aria-hidden="true" />
              <div>
                <p class="system__name">{s.name}</p>
                <p class="system__benefit">{s.benefit}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="shell why__inner">
      <div class="why__show">
        <FeatureArt kind="unified" />
      </div>
      <div class="why__say">
        <h2 class="why__title" id="why-title">
          <span class="why__titletext">Why "Chorus"?</span>
        </h2>
        <div class="why__text">
          <p class="why__lead">
            A chorus is where individual parts come together to create something
            stronger than they could on their own.
          </p>
          <p>Restaurants work the same way.</p>
          <p>
            Your website, guest communications, reviews, marketing, private
            events, and customer relationships all play an important role. But
            when they're disconnected, opportunities are missed and the guest
            experience suffers.
          </p>
          <p>
            Tempo Chorus brings every interaction together into one connected
            system — so your restaurant delivers a more consistent experience,
            builds stronger guest relationships, and grows with less effort.
          </p>
          <p class="why__close">All together now.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="care" aria-labelledby="care-title">
    <div class="shell care__inner">
      <div class="care__say">
        <h2 class="eyeless-h2 care__title" id="care-title">
          You won't be handed a login<br /> and left to figure it out.
        </h2>
        <p class="lede care__lede">
          Chorus gives you the tools. Tempo gives you the team behind them.
        </p>
      </div>
      <ul class="care__list">
        {
          care.map((c) => (
            <li>
              <span class="dot" aria-hidden="true" />
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pricing-preview" aria-labelledby="pricing-preview-title">
    <div class="shell">
      <h2 class="eyeless-h2 pp__title" id="pricing-preview-title">Simple pricing. Complete platform.</h2>
      <div class="pp__card pp__card--solo">
        <p class="pp__name">{plan.name}</p>
        <p class="pp__price">{plan.price}<span>/mo</span></p>
        <p class="pp__note">{plan.note}</p>
      </div>
      <a class="hero__link pp__more" href="/pricing">See full pricing and what's included →</a>
    </div>
  </section>

  <section class="demo" id="demo" aria-labelledby="demo-title">
    <div class="shell demo__inner">
      <div class="demo__pitch">
        <h2 class="demo__title" id="demo-title">
          One Platform.<br /> Configured for the Way You Operate.
        </h2>
        <p class="demo__sub">
          A personalized walkthrough of Tempo Chorus — not a generic software
          tour. Tell us how your restaurant runs and we'll show you exactly
          where it fits.
        </p>
        <ul class="demo__points">
          <li><span class="dot" aria-hidden="true" />Around 30 minutes, with someone who has worked in restaurants.</li>
          <li><span class="dot" aria-hidden="true" />Built around your concept, your locations, your service.</li>
          <li><span class="dot" aria-hidden="true" />No obligation, and no pretending your current setup is worse than it is.</li>
        </ul>
      </div>

      <div class="demo__form">
        <div class="booking">
          <p class="booking__heading">Pick a time</p>
          <div class="booking__widget">
            <iframe
              src={`${GHL_DOMAIN}/widget/booking/${CALENDAR_ID}`}
              title="Book a Tempo Chorus demo"
              allow="payment"
              scrolling="no"
              id={WIDGET_ID}
            ></iframe>
          </div>
          <p class="booking__note">
            Around 30 minutes. You'll get a confirmation by email and a reminder
            the day before — sent, as it happens, by Chorus.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="parent" aria-labelledby="parent-title">
    <div class="shell parent__inner">
      <h2 class="parent__title" id="parent-title">
        More than a marketing platform.
      </h2>
      <div class="parent__text">
        <p>
          Tempo Chorus is backed by Tempo Hospitality Group, a restaurant
          advisory agency working across marketing, operations, financial
          performance, technology and growth.
        </p>
        <p>
          That means we don't look at marketing in isolation. We understand
          how it connects to the rest of your restaurant — and what actually
          has to happen to turn marketing activity into profitable
          customers.
        </p>
      </div>
    </div>
  </section>

  <!-- GoHighLevel's resize script: lets the booking iframe report its own
       height so the panel grows with the widget instead of scrolling. -->
  <script is:inline src={`${GHL_DOMAIN}/js/form_embed.js`}></script>
</Base>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    min-height: clamp(32rem, 78vh, 48rem);
    display: flex;
    align-items: center;
    padding-block: clamp(5rem, 12vh, 9rem) clamp(3.5rem, 8vh, 6rem);
    isolation: isolate;
    overflow: hidden;
  }

  .hero__floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    z-index: 3;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--violet-500) 70%, transparent) 20%,
      color-mix(in oklab, var(--mint-400) 55%, transparent) 55%,
      color-mix(in oklab, var(--violet-500) 70%, transparent) 80%,
      transparent
    );
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }

  @media (max-width: 62rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__show {
      margin-top: 1rem;
    }
  }

  .hero__title {
    font-size: clamp(2.3rem, 1.4rem + 4.4vw, 4.6rem);
    letter-spacing: -0.045em;
  }

  .hero__accent {
    color: var(--mint-400);
  }

  .hero__sub {
    margin-top: 1.6rem;
    max-width: 46ch;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    line-height: 1.5;
    color: var(--text-mid);
  }

  .hero__sub strong {
    color: var(--text-hi);
    font-weight: 600;
  }

  .hero__actions {
    margin-top: 2.4rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .hero__link {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--violet-400);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--violet-400) 45%, transparent);
    padding-bottom: 2px;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .hero__link:hover {
    color: var(--text-hi);
    border-bottom-color: var(--text-hi);
  }

  /* ---------- Four Jobs ---------- */

  .jobs {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* 25% taller than the original clamp(4.5rem,10vw,8rem)/clamp(3rem,7vw,5rem) */
    padding-block: clamp(5.6rem, 12.5vw, 10rem) clamp(3.75rem, 8.75vw, 6.25rem);
  }

  .jobs__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Knocks the footage back so it reads as ambiance behind the cards, never
     competing with them — a dark violet wash, not a plain black scrim. */
  .jobs__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--ink-900) 55%, transparent),
        color-mix(in oklab, var(--ink-900) 88%, transparent)
      ),
      color-mix(in oklab, var(--violet-700) 55%, transparent);
  }

  .jobs__shell {
    position: relative;
    z-index: 2;
  }

  .jobs__grid {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
    background: color-mix(in oklab, var(--violet-500) 20%, transparent);
    border: 1px solid color-mix(in oklab, var(--violet-500) 20%, transparent);
    border-radius: 5px;
    overflow: hidden;
  }

  .job {
    background: var(--ink-800);
    padding: clamp(1.75rem, 3vw, 2.25rem);
  }

  .job__mark {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--violet-400);
  }

  .job__mark svg {
    width: 100%;
    height: 100%;
  }

  .job__name {
    margin-top: 1.25rem;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    color: var(--text-hi);
  }

  .job__line {
    margin-top: 0.65rem;
    max-width: 26ch;
    color: var(--text-mid);
  }

  /* ---------- Vignette chain ---------- */

  .chain {
    padding-block: clamp(5rem, 11vw, 9rem) clamp(3rem, 7vw, 5rem);
    background: var(--ink-800);
  }

  .chain__lede {
    margin-top: 1.25rem;
    color: var(--text-low);
  }

  .chain__list {
    position: relative;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 5.5rem);
    padding-left: clamp(1.5rem, 4vw, 3.25rem);
  }

  .chain__spine {
    position: absolute;
    left: 0;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 2px;
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in oklab, var(--violet-600) 85%, transparent) 4%,
      color-mix(in oklab, var(--violet-600) 85%, transparent) 92%,
      transparent
    );
  }

  .vignette {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 19rem);
    align-items: center;
    gap: clamp(1.75rem, 5vw, 3.5rem);
    max-width: 68rem;
  }

  .vignette__say {
    max-width: 54ch;
  }

  .vignette--wide .vignette__say {
    max-width: 68ch;
  }

  .vignette::before {
    content: "";
    position: absolute;
    left: clamp(-3.25rem, -4vw, -1.5rem);
    top: 0.85rem;
    width: clamp(1.5rem, 4vw, 3.25rem);
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--violet-500) 78%, transparent),
      color-mix(in oklab, var(--violet-500) 40%, transparent)
    );
  }

  .vignette__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--ink-700);
    box-shadow: 0 24px 40px -22px rgb(0 0 0 / 0.7);
  }

  .vignette__asset {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A light violet wash to keep photography/video on-brand rather than
     reading as stock imagery — deliberately lighter than the Four Jobs
     background treatment, since these sit as small supporting frames rather
     than a full-bleed backdrop. */
  .vignette__veil {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--violet-700) 26%, transparent);
  }

  @media (max-width: 56rem) {
    .vignette {
      grid-template-columns: 1fr;
    }

    .vignette__media {
      order: -1;
      max-width: 22rem;
    }
  }

  .vignette__marker {
    margin-top: 0.75rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-style: italic;
    color: var(--amber-400);
  }

  .vignette__trigger {
    font-size: clamp(1.3rem, 0.95rem + 1.7vw, 2.1rem);
    letter-spacing: -0.032em;
    color: var(--text-hi);
  }

  .vignette__rule {
    margin-top: 1.5rem;
    height: 1px;
    width: min(100%, 26rem);
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--violet-500) 60%, transparent),
      transparent
    );
  }

  .vignette__response {
    margin-top: 1.35rem;
    display: flex;
    gap: 0.9rem;
    color: var(--text-mid);
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.05rem);
    line-height: 1.62;
  }

  .vignette__response .dot {
    color: var(--mint-400);
    margin-top: 0.62em;
  }

  .chain__coda {
    margin-top: clamp(4rem, 9vw, 6.5rem);
    padding-top: 2.25rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 26%, transparent);
  }

  .chain__coda p {
    max-width: 58ch;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 0.95rem + 1vw, 1.65rem);
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.025em;
    color: var(--text-hi);
  }

  /* ---------- Restaurant Systems ---------- */

  .systems {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .systems__lede {
    margin-top: 1.25rem;
    color: var(--text-low);
  }

  .systems__list {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 6vw, 5rem);
  }

  .system {
    display: flex;
    gap: 0.9rem;
    padding-block: 1.15rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 20%, transparent);
  }

  .system .dot {
    margin-top: 0.55em;
    color: var(--violet-400);
  }

  .system__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.025em;
    color: var(--text-hi);
  }

