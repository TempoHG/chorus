---
/* Site-wide promo popup for the onboarding-fee waiver offer. Shows once per
   browser tab session (sessionStorage-gated, see initOnboardingPopup in
   motion.js), a few seconds after load, and stays dismissed once closed.
   Deliberately terse — an ad-style hook, not the full explanation that
   lives on the pricing page's onboarding panel. */
const popup = {
  badge: "Special Offer",
  save: "Save $497!",
  saveLabel: "on your onboarding fee",
  body: "Commit to 3 months of Chorus at $299/mo and the setup fee's on us.",
  cta: "Claim This Offer",
  // Standard UTM params on the CTA so GHL's embed script (which reads the
  // parent page's URL) can attribute the resulting booking/lead back to
  // this specific popup, separate from every other "Book a demo" CTA on
  // the site — whether it actually lands on the contact record depends on
  // how UTM capture is set up in GHL, not on anything this site controls.
  // promo matches the pricing page's onboarding-panel CTA (same discount,
  // same campaign) — utm_source is what actually tells the two apart.
  ctaHref:
    "/?utm_source=popup&utm_medium=site&utm_campaign=onboarding_fee_waiver&promo=SAVE497#demo",
};
---

<div class="popup" data-onboarding-popup>
  <div class="popup__backdrop" data-popup-backdrop data-popup-close></div>
  <div
    class="popup__card"
    data-popup-card
    role="dialog"
    aria-modal="true"
    aria-labelledby="popup-title"
  >
    <button type="button" class="popup__close" data-popup-close aria-label="Close">
      <span aria-hidden="true">&times;</span>
    </button>

    <span class="popup__badge">{popup.badge}</span>

    <p class="popup__save" id="popup-title">{popup.save}</p>
    <p class="popup__save-label">{popup.saveLabel}</p>

    <p class="popup__body">{popup.body}</p>

    <a class="btn popup__cta" href={popup.ctaHref}>{popup.cta}</a>
    <button type="button" class="popup__later" data-popup-close>Maybe later</button>
  </div>
</div>

<style>
  .popup {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 300;
  }

  .popup__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--ink-900) 82%, transparent);
    backdrop-filter: blur(6px);
  }

  .popup__card {
    /* Centering (xPercent/yPercent) is set once via GSAP in motion.js, not
       CSS transform: the moment GSAP animates y/scale/opacity on this
       element it takes full ownership of `transform` and silently drops a
       CSS-only translate — the same gotcha documented in DESIGN.md for the
       hero and orbit graphic. */
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(90vw, 23rem);
    text-align: center;
    background: var(--ink-700);
    border: 1px solid color-mix(in oklab, var(--mint-400) 45%, transparent);
    border-radius: 8px;
    padding: clamp(2rem, 5vw, 2.75rem) clamp(1.75rem, 4vw, 2.25rem);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--mint-400) 15%, transparent),
      0 30px 60px -20px rgb(0 0 0 / 0.8),
      0 0 90px -10px color-mix(in oklab, var(--mint-400) 35%, transparent);
  }

  .popup__close {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--text-low);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    transition: color 0.2s var(--ease-out), background 0.2s var(--ease-out);
  }

  .popup__close:hover {
    color: var(--text-hi);
    background: color-mix(in oklab, var(--violet-500) 25%, transparent);
  }

  .popup__badge {
    display: inline-block;
    background: var(--mint-400);
    color: var(--ink-900);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }

  .popup__save {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3rem;
    letter-spacing: -0.03em;
    color: var(--mint-300);
  }

  .popup__save-label {
    margin-top: 0.1rem;
    font-size: 0.9rem;
    color: var(--text-low);
  }

  .popup__body {
    margin-top: 1.1rem;
    color: var(--text-hi);
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .popup__cta {
    margin-top: 1.5rem;
    width: 100%;
    justify-content: center;
  }

  .popup__later {
    display: block;
    margin: 0.85rem auto 0;
    background: transparent;
    border: 0;
    color: var(--text-low);
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    transition: color 0.2s var(--ease-out);
  }

  .popup__later:hover {
    color: var(--text-hi);
  }

  @media (max-width: 30rem) {
    .popup__save {
      font-size: 2.5rem;
    }
  }

  /* body lives outside this component's own template (Base.astro owns it),
     so reaching it needs :global — same scoping gotcha documented in
     DESIGN.md for the `.js` selector. */
  :global(body.has-popup) {
    overflow: hidden;
  }
</style>
