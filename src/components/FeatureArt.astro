---
import TempoMark from "./TempoMark.astro";
import Wordmark from "./Wordmark.astro";

/* The site's shared library of authored UI-mockup panels — restaurant
   surfaces shown doing their job, not stock photography and not literal
   musical notation. Every name, figure and timestamp below is authored
   demonstration material, not a real customer record — the footer labels
   it, and PRODUCT.md lists it for replacement with real screens. Used on
   the homepage (a handful of these, as general proof) and on the features
   page (one per capability category). Each panel gets a small, restrained
   entrance the first time it scrolls into view — see the reveal script in
   Base.astro. */
interface Props {
  kind:
    | "calendar"
    | "marketing-calendar"
    | "reviews"
    | "reservations"
    | "inbox"
    | "afterhours"
    | "attribution"
    | "unified"
    | "agent";
}
const { kind } = Astro.props;

/* --- Get Found: a month of guest communication --- */
const channels = [
  { name: "Email", tone: "violet" },
  { name: "Text", tone: "green" },
  { name: "Social", tone: "lilac" },
  { name: "Ads", tone: "amber" },
];
const month: Record<number, { label: string; time: string; tone: string }[]> = {
  3: [{ label: "New menu email", time: "9:00", tone: "violet" }],
  4: [{ label: "Lunch special", time: "11:00", tone: "green" }],
  5: [{ label: "Instagram post", time: "12:00", tone: "lilac" }],
  6: [{ label: "Weekend push", time: "17:00", tone: "amber" }],
  9: [{ label: "Behind the pass", time: "14:00", tone: "lilac" }],
  10: [{ label: "Win-back send", time: "9:00", tone: "violet" }],
  12: [{ label: "Table reminder", time: "16:00", tone: "green" }],
  13: [{ label: "Local promotion", time: "8:00", tone: "amber" }],
  17: [{ label: "Review request", time: "10:00", tone: "green" }],
  19: [{ label: "Private events", time: "13:00", tone: "violet" }],
  20: [{ label: "Friday push", time: "16:00", tone: "green" }],
  24: [{ label: "Regulars offer", time: "9:00", tone: "violet" }],
  26: [{ label: "Half-term", time: "11:00", tone: "lilac" }],
};

/* --- Guest Marketing (homepage story): a May campaign calendar,
   Mother's Day the standout send, plus a small performance snapshot --- */
const mayMonth: Record<number, { label: string; time: string; tone: string }[]> = {
  1: [{ label: "Spring menu launch", time: "9:00", tone: "violet" }],
  5: [{ label: "Cinco de Mayo post", time: "11:00", tone: "lilac" }],
  6: [{ label: "Patio season email", time: "9:00", tone: "violet" }],
  7: [{ label: "Mother's Day countdown", time: "8:00", tone: "amber" }],
  8: [{ label: "Reserve for Mom text", time: "10:00", tone: "green" }],
  10: [{ label: "Mother's Day brunch", time: "9:00", tone: "violet" }],
  12: [{ label: "Thank-you send", time: "15:00", tone: "green" }],
  15: [{ label: "Graduation parties", time: "12:00", tone: "lilac" }],
  18: [{ label: "Review request", time: "10:00", tone: "green" }],
  22: [{ label: "Weekend push", time: "16:00", tone: "amber" }],
  25: [{ label: "Memorial Day BBQ", time: "9:00", tone: "violet" }],
  29: [{ label: "Local promotion", time: "8:00", tone: "amber" }],
};
const snapshot = [
  "1,247 emails", "386 texts", "42 birthday offers", "71 review requests", "12 social posts",
];

/* --- Guest Marketing (homepage story): the calendar's rotating siblings —
   one small card per channel/campaign type, cycling in the same stage. The
   "Text" slide uses the thread/panel vocabulary from kind="inbox" instead
   of the subject/preview card the rest share, since a text is a two-way
   exchange, not a broadcast. */
const channelCards = [
  {
    id: "email",
    title: "Email",
    tag: "Weekly send",
    tone: "violet",
    subject: "This Friday: Patio Season Opens \u{1F33F}",
    preview: "Live music, a new rosé, and your favorite table waiting.",
    sum: "Sent to 1,204 guests · 48% open rate",
  },
  {
    id: "social",
    title: "Social",
    tag: "Instagram",
    tone: "lilac",
    subject: "Behind the pass, tonight →",
    preview: "Tonight's special, plated and ready to go out.",
    sum: "312 likes · 18 comments · cross-posted to Facebook",
  },
  {
    id: "birthdays",
    title: "Birthdays",
    tag: "Automated",
    tone: "amber",
    subject: "Happy Birthday, Marcus! \u{1F382}",
    preview: "A free dessert is waiting whenever you're ready to celebrate.",
    sum: "Sent automatically · no one has to remember",
  },
  {
    id: "promotions",
    title: "Promotions",
    tag: "Weekend push",
    tone: "violet",
    subject: "20% off drinks, Friday–Sunday",
    preview: "Just for the regulars who haven't been in this month.",
    sum: "Sent to 842 guests in under a minute",
  },
  {
    id: "winbacks",
    title: "Win-backs",
    tag: "45 days inactive",
    tone: "green",
    subject: "We miss you, Elena",
    preview: "It's been a while — come back this week for a complimentary appetizer.",
    sum: "Triggered automatically · no list to manage",
  },
];
const textExchange = [
  { src: "Guest", text: "Any chance of a window table Friday?", time: "4:12 PM", ours: false },
  { src: "Chorus", text: "You're set — Friday 7:30, window requested.", time: "4:12 PM", ours: true },
];

/* --- Bring Guests Back: the review queue --- */
const reviews = [
  {
    source: "Google",
    stars: 5,
    quote: "The carbonara is the best I have had outside Rome.",
    who: "Marta L.",
    state: "replied",
    when: "Replied in 40 min",
  },
  {
    source: "Facebook",
    stars: 5,
    quote: "Booked for eight and they remembered the birthday.",
    who: "Dan R.",
    state: "replied",
    when: "Replied in 2 hrs",
  },
  {
    source: "Google",
    stars: 3,
    quote: "Food was excellent. Waited 25 minutes for the check.",
    who: "Priya S.",
    state: "needs-human",
    when: "Flagged for you",
  },
];

/* --- Save Time: a service, running itself --- */
const service = [
  { time: "18:00", party: "Party of 2", note: "Confirmed", state: "ok" },
  { time: "18:30", party: "Party of 4", note: "Reminded yesterday", state: "ok" },
  { time: "19:00", party: "Party of 8", note: "Cancelled 16:12 — table released", state: "alert" },
  { time: "19:30", party: "Party of 6", note: "Confirmed · allergy noted", state: "ok" },
  { time: "20:00", party: "Party of 2", note: "Waitlist promoted", state: "new" },
];

/* --- Stay Connected: one guest, every channel --- */
const thread = [
  { src: "Instagram", text: "Do you do anything gluten-free?", time: "Sun 9:12", ours: false },
  { src: "Text", text: "Any chance of a table for 4 Friday?", time: "Wed 16:40", ours: false },
  { src: "Chorus", text: "Friday 7:30 confirmed. Noted GF for the kitchen.", time: "Wed 16:40", ours: true },
];

/* --- Save Time: the after-hours call --- */
const steps = [
  "Chorus answers on the second ring",
  "“Table for six, Saturday, around 7:30”",
  "Held against the floor plan",
];

/* --- Get Found: an ad, followed all the way to the table --- */
const flow = [
  { label: "Tuesday", title: "Sees your ad", meta: "Instagram · 2 miles away", done: false },
  { label: "Tuesday", title: "Lands on your page", meta: "Menu · Book a table", done: false },
  { label: "Friday", title: "Sits down", meta: "Party of 2 · 8:00 PM", done: true },
];

/* --- Why Chorus: six separate tools, orbiting one system --- */
const orbit = [
  "Website",
  "Phone",
  "Text",
  "Email",
  "Social",
  "Reviews",
];
---

<figure class="art">
  {
    kind === "calendar" && (
      <div class="art__stage" data-reveal-solo>
        <div class="art__head">
          <p class="art__title">February</p>
          <ul class="chips">
            {channels.map((c) => (
              <li class={`chip chip--${c.tone}`}>{c.name}</li>
            ))}
          </ul>
        </div>
        <div class="cal">
          {["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map((d) => (
            <p class="cal__dow">{d}</p>
          ))}
          {
            Array.from({ length: 28 }, (_, i) => i + 1).map((day) => (
              <div class="cal__day">
                <span class="cal__num">{day}</span>
                {(month[day] ?? []).map((e) => (
                  <span class={`cal__entry cal__entry--${e.tone}`}>
                    <span class="cal__label">{e.label}</span>
                    <span class="cal__time">{e.time}</span>
                  </span>
                ))}
              </div>
            ))
          }
        </div>
        <p class="art__sum">One sitting to approve · four channels · a month of guest contact</p>
      </div>
    )
  }

  {
    kind === "marketing-calendar" && (
      <div class="art__stage" data-reveal-solo>
        <div class="rotator" data-channel-rotator>
          <div class="rotator__slide is-active" data-rotator-slide>
            <div class="art__head">
              <p class="art__title">May</p>
              <ul class="chips">
                {channels.map((c) => (
                  <li class={`chip chip--${c.tone}`}>{c.name}</li>
                ))}
              </ul>
            </div>
            <div class="cal">
              {["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map((d) => (
                <p class="cal__dow">{d}</p>
              ))}
              {
                Array.from({ length: 31 }, (_, i) => i + 1).map((day) => (
                  <div class={`cal__day ${day === 10 ? "cal__day--feature" : ""}`}>
                    <span class="cal__num">{day}</span>
                    {(mayMonth[day] ?? []).map((e) => (
                      <span class={`cal__entry cal__entry--${e.tone}`}>
                        <span class="cal__label">{e.label}</span>
                        <span class="cal__time">{e.time}</span>
                      </span>
                    ))}
                  </div>
                ))
              }
            </div>
            <p class="art__sum">A month of sends, one Sunday brunch campaign at the center of it</p>
            <div class="snapshot">
              <p class="art__label">This month</p>
              {snapshot.map((line) => <p class="snapshot__row">{line}</p>)}
            </div>
          </div>

          <div class="rotator__slide" data-rotator-slide>
            <div class="art__head">
              <p class="art__title">Text</p>
              <span class="chip chip--green">Two-way SMS</span>
            </div>
            <div class="panel channel__panel">
              <ul class="thread">
                {textExchange.map((t) => (
                  <li class={t.ours ? "is-ours" : ""}>
                    <span class="thread__src">{t.src}</span>
                    <p>“{t.text}”</p>
                    <span class="thread__time">{t.time}</span>
                  </li>
                ))}
              </ul>
            </div>
            <p class="art__sum">94% of texts read within 3 minutes</p>
          </div>

          {channelCards.map((c) => (
            <div class="rotator__slide" data-rotator-slide>
              <div class="art__head">
                <p class="art__title">{c.title}</p>
                <span class={`chip chip--${c.tone}`}>{c.tag}</span>
              </div>
              <div class="channel__msg">
                <p class="channel__subject">{c.subject}</p>
                <p class="channel__preview">{c.preview}</p>
              </div>
              <p class="art__sum">{c.sum}</p>
            </div>
          ))}

          <div class="rotator__nav" role="tablist" aria-label="Campaign type">
            <button type="button" class="rotator__dot is-active" data-rotator-dot aria-label="Show May calendar" aria-selected="true" role="tab" />
            <button type="button" class="rotator__dot" data-rotator-dot aria-label="Show Text example" aria-selected="false" role="tab" />
            {channelCards.map((c) => (
              <button type="button" class="rotator__dot" data-rotator-dot aria-label={`Show ${c.title} example`} aria-selected="false" role="tab" />
            ))}
          </div>
        </div>
      </div>
    )
  }

  {
    kind === "reviews" && (
      <div class="art__stage">
        <div class="art__head">
          <p class="art__title">Reviews</p>
          <p class="art__meta">Every platform, one queue</p>
        </div>
        <ul class="rev" data-review-loop>
          {reviews.map((r, i) => (
            <li class={`rev__row rev__row--${r.state}`} style={`--i:${i}`}>
              <div class="rev__top">
                <span class="rev__src">{r.source}</span>
                <span class="rev__stars" aria-label={`${r.stars} out of 5`}>
                  {Array.from({ length: 5 }, (_, i) => (
                    <span class={`star ${i < r.stars ? "is-lit" : ""}`} aria-hidden="true" />
                  ))}
                </span>
                <span class="rev__who">{r.who}</span>
              </div>
              <p class="rev__quote">“{r.quote}”</p>
              <p class="rev__state">{r.when}</p>
            </li>
          ))}
        </ul>
        <p class="art__sum">Asked automatically · answered by a human when it matters</p>
      </div>
    )
  }

  {
    kind === "reservations" && (
      <div class="art__stage">
        <div class="art__head">
          <p class="art__title">Friday service</p>
          <p class="art__pill"><span class="art__dot" aria-hidden="true" />Live</p>
        </div>
        <ul class="svc" data-reveal>
          {service.map((s, i) => (
            <li class={`svc__row svc__row--${s.state}`} style={`--i:${i}`}>
              <span class="svc__time">{s.time}</span>
              <span class="svc__party">{s.party}</span>
              <span class="svc__note">{s.note}</span>
            </li>
          ))}
        </ul>
        <p class="art__sum">3 reminders sent · 1 table resold · nobody made a call</p>
      </div>
    )
  }

  {
    kind === "inbox" && (
      <div class="art__stage art__stage--inbox">
        <div class="chips chips--stack" aria-hidden="true">
          <span class="chip">Instagram</span>
          <span class="chip">Text</span>
          <span class="chip">Phone</span>
        </div>

        <svg class="wires" viewBox="0 0 90 210" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 26 H46 C64 26 62 105 82 105" />
          <path d="M0 105 H82" />
          <path d="M0 184 H46 C64 184 62 105 82 105" />
        </svg>

        <div class="panel">
          <div class="panel__head">
            <p class="art__meta">One guest record</p>
            <p class="panel__name">Sarah Chen</p>
            <p class="rev__state" style="color: var(--text-mid)">Since March · 6 visits · usually table 9</p>
          </div>
          <ul class="thread" data-reveal>
            {thread.map((t, i) => (
              <li class={t.ours ? "is-ours" : ""} style={`--i:${i}`}>
                <span class="thread__src">{t.src}</span>
                <p>“{t.text}”</p>
                <span class="thread__time">{t.time}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }

  {
    kind === "afterhours" && (
      <div class="art__stage art__stage--night">
        <div class="panel panel--call">
          <div class="panel__head panel__head--row">
            <span class="pulse" aria-hidden="true" />
            <div>
              <p class="art__meta">Incoming · after close</p>
              <p class="panel__name panel__name--sm">11:47 PM, Tuesday</p>
            </div>
          </div>
          <ol class="steps" data-reveal>
            {steps.map((s, i) => (
              <li style={`--i:${i}`}>
                <span class="steps__dot" aria-hidden="true" />
                {s}
              </li>
            ))}
            <li class="is-done" style={`--i:${steps.length}`}>
              <span class="steps__dot" aria-hidden="true" />
              Confirmation texted — 11:48 PM
            </li>
          </ol>
        </div>

        <div class="tile" data-reveal-solo>
          <p class="art__label">Calls answered after close</p>
          <p class="tile__value" data-count-to="47">0</p>
          <p class="rev__state" style="color: var(--text-mid)">this month · 0 missed</p>
        </div>
      </div>
    )
  }

  {
    kind === "attribution" && (
      <div class="art__stage art__stage--ads">
        <div class="flowcards" data-reveal>
          {flow.map((f, i) => (
            <>
              <div class={`fcard ${f.done ? "fcard--done" : ""}`} style={`--i:${i * 2}`}>
                <p class="art__label">{f.label}</p>
                <p class="fcard__title">{f.title}</p>
                <p class="rev__state" style="color: var(--text-mid)">{f.meta}</p>
              </div>
              {i < flow.length - 1 && <span class="flowline" style={`--i:${i * 2 + 1}`} aria-hidden="true" />}
            </>
          ))}
        </div>

        <div class="attrib">
          <div class="attrib__mark" aria-hidden="true">
            <TempoMark class="attrib__spark" />
          </div>
          <p class="art__sum" style="margin:0;padding:0;border:0;max-width:60ch;font-size:1rem;color:var(--text-hi)">
            Chorus knows those were the same person — so the spend has a table
            attached to it, not a click.
          </p>
        </div>
      </div>
    )
  }

  {
    kind === "unified" && (
      <div class="unified__wrap">
        <div class="unified__orbit" data-orbit-reveal>
          {orbit.map((name) => (
            <div class="unified__tablet">
              <span class="unified__tablet-chip">{name}</span>
            </div>
          ))}
          <span class="unified__node">
            <Wordmark class="unified__node-logo" height={34} />
            <p class="unified__node-tagline">
              The restaurant growth platform that brings everything together.
            </p>
          </span>
        </div>
      </div>
    )
  }

  {
    kind === "agent" && (
      <div class="art__stage agent" data-agent-card data-reveal-solo>
        <div class="agent__idle" data-step-idle>
          <p class="agent__status">
            <span class="agent__status-dot" aria-hidden="true" />
            Agent ready
          </p>
          <div class="agent__rings" aria-hidden="true">
            <svg class="agent__rings-svg" viewBox="0 0 220 220" fill="none">
              <circle
                cx="110" cy="110" r="95"
                stroke="var(--mint-400)" stroke-width="2" stroke-linecap="round"
                stroke-dasharray="420 180" opacity="0.35"
                transform="rotate(-90 110 110)"
              />
              <circle
                cx="110" cy="110" r="78"
                stroke="var(--mint-400)" stroke-width="2" stroke-linecap="round"
                stroke-dasharray="270 220" opacity="0.55"
                transform="rotate(60 110 110)"
              />
              <circle
                cx="110" cy="110" r="60"
                stroke="var(--text-low)" stroke-width="2" stroke-linecap="round"
                stroke-dasharray="95 285" opacity="0.5"
                transform="rotate(205 110 110)"
              />
            </svg>
            <button type="button" class="agent__core" data-start-call aria-label="Start test call">
              <svg class="agent__mic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M12 15a3.5 3.5 0 0 0 3.5-3.5V5.5a3.5 3.5 0 0 0-7 0v6A3.5 3.5 0 0 0 12 15Z" />
                <path d="M18.5 11a1 1 0 1 0-2 0 4.5 4.5 0 0 1-9 0 1 1 0 1 0-2 0 6.5 6.5 0 0 0 5.5 6.42V19H9a1 1 0 1 0 0 2h6a1 1 0 1 0 0-2h-2.5v-1.58A6.5 6.5 0 0 0 18.5 11Z" />
              </svg>
            </button>
          </div>
          <p class="agent__intro">
            Give us your number and we'll call you back — usually within a few minutes.
          </p>
          <button type="button" class="agent__cta" data-start-call>
            <svg class="agent__phone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.28 21 3 13.72 3 4.75a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2Z" />
            </svg>
            Start test call
          </button>
          <p class="agent__note">No sales pitch. A live demo on your own phone.</p>
        </div>

        <form
          class="agent__form"
          data-lead-form
          data-consent-text="I agree to receive automated and artificial voice calls and text messages from Tempo Chorus at the number provided, including for marketing. Consent is not a condition of purchase. Msg and data rates may apply. Calls may be recorded and stored as described in the Terms of Service and Privacy Policy."
          novalidate
          hidden
        >
          <p class="agent__form-label">Three things and it calls</p>
          <div class="agent__form-grid">
            <div class="agent__row" data-row>
              <label class="agent__field-label">
                First name
                <input class="agent__field" name="first_name" type="text" autocomplete="given-name" placeholder="Alex" data-field />
              </label>
              <p class="agent__field-error" data-error role="alert" hidden />
            </div>
            <div class="agent__row" data-row>
              <label class="agent__field-label">
                Email
                <input class="agent__field" name="email" type="email" inputmode="email" autocomplete="email" placeholder="alex@yourrestaurant.com" data-field />
              </label>
              <p class="agent__field-error" data-error role="alert" hidden />
            </div>
            <div class="agent__row" data-row>
              <label class="agent__field-label">
                Mobile number
                <input class="agent__field" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(555) 123-4567" data-field />
              </label>
              <p class="agent__field-error" data-error role="alert" hidden />
            </div>
          </div>

          {/* Honeypot: real people never fill this in. */}
          <div class="agent__honeypot" aria-hidden="true">
            <label>
              Website
              <input name="website" type="text" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <label class="agent__consent">
            <input type="checkbox" name="consent" class="agent__consent-input" data-consent required />
            <span class="agent__consent-box" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5">
                <path d="m5 12.5 4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="agent__consent-text">
              I agree to receive automated and artificial voice calls and text messages from
              Tempo Chorus at the number provided, including for marketing. Consent is not a
              condition of purchase. Msg and data rates may apply. Calls may be recorded and
              stored as described in the{" "}
              <a href="https://www.tempohg.com/terms-conditions" target="_blank" rel="noopener">Terms of Service</a> and{" "}
              <a href="https://www.tempohg.com/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>.
            </span>
          </label>
          <p class="agent__consent-error" data-consent-error role="alert" hidden />

          <button type="submit" class="agent__submit">Call me now</button>
          <p class="agent__form-error" data-form-error role="alert" hidden />
        </form>

        <div class="agent__done" data-step-done hidden>
          <span class="agent__done-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
