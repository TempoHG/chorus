  .unified__node-tagline {
    margin: 0;
    max-width: 11rem;
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--text-mid);
  }

  /* The tags' motion — spring out from behind the node, orbit clockwise,
     retract, loop — is driven entirely by orbitReveals() in
     src/scripts/motion.js, since it's continuous and CSS can't own that. */

  @media (max-width: 30rem) {
    .unified__orbit {
      height: 22rem;
    }
    .unified__tablet {
      padding: 0.6rem 1rem;
    }
    .unified__tablet-chip {
      font-size: 0.92rem;
    }
    .unified__node {
      max-width: 9.5rem;
    }
    /* :global is required here: this class lives on the <img> rendered
       inside Wordmark.astro's own template, so it carries Wordmark's scope
       attribute, not this file's — a plain scoped selector can never match
       it (same gotcha as the `.js` selector documented in DESIGN.md). */
    :global(.unified__node-logo) {
      height: 26px !important;
      width: auto !important;
    }
    .unified__node-tagline {
      max-width: 9rem;
      font-size: 0.68rem;
    }
  }

  /* ---- agent: the AI Host Helper "test call" widget ---- */

  .agent {
