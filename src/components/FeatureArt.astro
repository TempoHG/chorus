  /* ---- unified: six tools orbiting one system ---- */

  /* No card, no fill — this sits directly on the section's own background,
     not inside a separate dark panel. */
  .unified__wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .unified__orbit {
    position: relative;
    width: 100%;
    max-width: 32rem;
    height: 29rem;
  }

  .unified__tablet {
    /* Anchored dead-center; the orbit position (and centering) is set
       entirely by GSAP (motion.js) via x/y + xPercent/yPercent, since it
       needs to move continuously — CSS can't drive that. */
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    background: var(--ink-700);
    border: 1px solid color-mix(in oklab, var(--violet-500) 32%, transparent);
    border-radius: 0.85rem;
