  .unified__node {
    /* Centering set by GSAP (motion.js) — see note on .unified__tablet. */
    position: absolute;
    top: 50%;
    left: 50%;
    width: max-content;
    max-width: 12rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
    z-index: 2;
