---
import TempoMark from "./TempoMark.astro";

const voices = [
  "Digital ads",
  "Your website",
  "The phone",
  "Text messages",
  "Email",
  "Google",
  "Reviews",
  "Reservations",
  "Social messages",
  "Private events",
  "Gift cards & loyalty",
  "Guest history",
];

const W = 1180;
const H = 560;
const top = 40;
const gap = (H - top * 2) / (voices.length - 1);
const labelX = 300;
const startX = labelX + 26;
const nodeX = 990;
const nodeY = H / 2;
const bend = nodeX - 300;
const stop = nodeX - 60;
---

<figure class="score">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="score-title score-desc" class="score__svg">
    <title id="score-title">Every guest channel joining one system</title>
    <desc id="score-desc">
      Twelve separate channels a restaurant uses — digital ads, website, phone,
      text messages, email, Google, reviews, reservations, social messages,
      private events, gift cards and loyalty, and guest history — each drawn as
      its own line, all curving in to meet at a single point marked Tempo
      Chorus.
    </desc>

    {
      voices.map((voice, i) => {
        const y = top + gap * i;
        return (
          <g class="score__voice" style={`--i:${i}`}>
            <text class="score__label" x={labelX} y={y} text-anchor="end" dominant-baseline="middle">
              {voice}
            </text>
            <path
              class="score__line"
              d={`M ${startX} ${y} H ${bend} C ${bend + 150} ${y} ${stop - 70} ${nodeY} ${stop} ${nodeY}`}
              fill="none"
            />
            <circle class="score__note" cx={startX + 3} cy={y} r="6" />
          </g>
        );
      })
    }

    <g class="score__node">
      <circle class="score__halo score__halo--far" cx={nodeX} cy={nodeY} r="86" />
      <circle class="score__halo" cx={nodeX} cy={nodeY} r="56" />
      <circle class="score__core" cx={nodeX} cy={nodeY} r="26" />
      <TempoMark class="score__spark" x={nodeX - 18} y={nodeY - 18} size={36} />
      <text class="score__nodelabel" x={nodeX} y={nodeY + 118} text-anchor="middle">Tempo Chorus</text>
    </g>
  </svg>

  <svg viewBox="0 0 420 690" class="score__svg score__svg--portrait" aria-hidden="true" focusable="false">
    {
      voices.map((voice, i) => {
        const y = 24 + i * 40;
        return (
          <g class="score__voice" style={`--i:${i}`}>
            <text class="score__label" x="4" y={y} dominant-baseline="middle">{voice}</text>
            <path
              class="score__line"
              d={`M 232 ${y} H 286 C 330 ${y} 344 ${y + 36} 344 516`}
              fill="none"
            />
            <circle class="score__note" cx="226" cy={y} r="5" />
          </g>
        );
      })
    }
    <g class="score__node">
      <circle class="score__halo score__halo--far" cx="344" cy="560" r="60" />
      <circle class="score__halo" cx="344" cy="560" r="39" />
      <circle class="score__core" cx="344" cy="560" r="19" />
      <TempoMark class="score__spark" x={331} y={547} size={26} />
      <text class="score__nodelabel" x="336" y="655" text-anchor="middle">Tempo Chorus</text>
    </g>
  </svg>

  <figcaption class="score__caption">
    <span class="score__side score__side--a">Twelve places to look.</span>
    <span class="score__side score__side--b">One conversation.</span>
  </figcaption>
</figure>

<style>
  .score {
    margin: 0;
  }

  .score__svg {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-body);
  }

  .score__label {
    fill: var(--text-hi);
    font-size: 25px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .score__line {
    stroke: color-mix(in oklab, var(--violet-500) 72%, transparent);
    stroke-width: 2;
  }

  .score__note {
    fill: var(--violet-400);
  }

  .score__halo {
    fill: color-mix(in oklab, var(--mint-400) 13%, transparent);
    stroke: color-mix(in oklab, var(--mint-400) 40%, transparent);
    stroke-width: 1.25;
  }

  .score__halo--far {
    fill: color-mix(in oklab, var(--mint-400) 6%, transparent);
    stroke: color-mix(in oklab, var(--mint-400) 18%, transparent);
  }

  .score__core {
    fill: var(--mint-400);
  }

  .score__spark {
    color: var(--ink-900);
  }

  .score__nodelabel {
    fill: var(--mint-300);
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Draw-in: the voices join the system one after another */
  :global(.js) .score__line {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
  }

  :global(.js) .score__note,
  :global(.js) .score__label,
  :global(.js) .score__node {
    opacity: 0;
  }

  :global(.js) .score .score__line {
    animation: draw 1.2s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 85ms);
  }

  :global(.js) .score .score__note,
  :global(.js) .score .score__label {
    animation: fade 0.55s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 85ms);
  }

  :global(.js) .score .score__node {
    animation: land 0.85s var(--ease-out) 1.05s forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  @keyframes land {
    from {
      opacity: 0;
      transform: scale(0.62);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .score__node {
    transform-box: fill-box;
    transform-origin: 50% 38%;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .score__line {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
    :global(.js) .score__note,
    :global(.js) .score__label,
    :global(.js) .score__node {
      opacity: 1;
      animation: none !important;
    }
  }

  .score__caption {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 26%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 0.95rem + 1vw, 1.65rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .score__side--a {
    color: var(--text-low);
    text-decoration-line: line-through;
    text-decoration-color: var(--amber-400);
    text-decoration-thickness: 2px;
  }

  .score__side--b {
    color: var(--mint-400);
  }

  .score__svg--portrait {
    display: none;
  }

  @media (max-width: 56rem) {
    .score__svg:not(.score__svg--portrait) {
      display: none;
    }
    .score__svg--portrait {
      display: block;
      max-width: 26rem;
    }
    .score__svg--portrait .score__label {
      font-size: 19px;
    }
    .score__svg--portrait .score__nodelabel {
      font-size: 24px;
    }
    .score__svg--portrait .score__line {
      stroke-width: 1.6;
    }
  }
</style>
