---
import TempoMark from "./TempoMark.astro";

/* Abstracted product mockups. Every name, figure and timestamp below is
   authored demonstration material, not a real customer record — the footer
   labels it, and PRODUCT.md lists it for replacement with real screens. */
---

<section class="mocks" id="mocks" aria-labelledby="mocks-title">
  <div class="shell">
    <h2 class="eyeless-h2 mocks__title" id="mocks-title">
      What it looks like<br /> when it's working.
    </h2>
    <p class="lede mocks__lede">
      Three ordinary moments, as Chorus actually handles them.
    </p>
  </div>

  <div class="shell mocks__grid">
    <!-- ---------- 1. One guest, every channel ---------- -->
    <figure class="mock">
      <div class="stage stage--inbox">
        <div class="chips" aria-hidden="true">
          <span class="chip">Instagram</span>
          <span class="chip">Text</span>
          <span class="chip">Phone</span>
        </div>

        <svg class="wires" viewBox="0 0 90 210" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 26 H46 C64 26 62 105 82 105" />
          <path d="M0 105 H82" />
          <path d="M0 184 H46 C64 184 62 105 82 105" />
        </svg>

        <div class="panel">
          <div class="panel__head">
            <p class="panel__eyebrow">One guest record</p>
            <p class="panel__name">Sarah Chen</p>
            <p class="panel__meta">Since March · 6 visits · usually table 9</p>
          </div>
          <ul class="thread">
            <li>
              <span class="thread__src">Instagram</span>
              <p>“Do you do anything gluten-free?”</p>
              <span class="thread__time">Sun 9:12</span>
            </li>
            <li>
              <span class="thread__src">Text</span>
              <p>“Any chance of a table for 4 Friday?”</p>
              <span class="thread__time">Wed 16:40</span>
            </li>
            <li class="is-ours">
              <span class="thread__src">Chorus</span>
              <p>Friday 7:30 confirmed. Noted GF for the kitchen.</p>
              <span class="thread__time">Wed 16:40</span>
            </li>
          </ul>
        </div>
      </div>
      <figcaption>
        Three channels, three days, one person — and the kitchen already knows.
      </figcaption>
    </figure>

    <!-- ---------- 2. After hours ---------- -->
    <figure class="mock">
      <div class="stage stage--night">
        <div class="panel panel--call">
          <div class="panel__head panel__head--row">
            <span class="pulse" aria-hidden="true"></span>
            <div>
              <p class="panel__eyebrow">Incoming · after close</p>
              <p class="panel__name panel__name--sm">11:47 PM, Tuesday</p>
            </div>
          </div>
          <ol class="steps">
            <li><span class="steps__dot" aria-hidden="true"></span>Chorus answers on the second ring</li>
            <li><span class="steps__dot" aria-hidden="true"></span>“Table for six, Saturday, around 7:30”</li>
            <li><span class="steps__dot" aria-hidden="true"></span>Held against the floor plan</li>
            <li class="is-done">
              <span class="steps__dot" aria-hidden="true"></span>Confirmation texted — 11:48 PM
            </li>
          </ol>
        </div>

        <div class="tile">
          <p class="tile__label">Calls answered after close</p>
          <p class="tile__value">47</p>
          <p class="tile__note">this month · 0 missed</p>
        </div>
      </div>
      <figcaption>
        The call you would have lost, booked before you woke up.
      </figcaption>
    </figure>

    <!-- ---------- 3. Ad to table ---------- -->
    <figure class="mock mock--wide">
      <div class="stage stage--ads">
        <div class="flowcards">
          <div class="fcard">
            <p class="fcard__label">Tuesday</p>
            <p class="fcard__title">Sees your ad</p>
            <p class="fcard__meta">Instagram · 2 miles away</p>
          </div>
          <span class="flowline" aria-hidden="true"></span>
          <div class="fcard">
            <p class="fcard__label">Tuesday</p>
            <p class="fcard__title">Lands on your page</p>
            <p class="fcard__meta">Menu · Book a table</p>
          </div>
          <span class="flowline" aria-hidden="true"></span>
          <div class="fcard fcard--done">
            <p class="fcard__label">Friday</p>
            <p class="fcard__title">Sits down</p>
            <p class="fcard__meta">Party of 2 · 8:00 PM</p>
          </div>
        </div>

        <div class="attrib">
          <div class="attrib__mark" aria-hidden="true">
            <TempoMark class="attrib__spark" />
          </div>
          <p class="attrib__text">
            Chorus knows those were the same person — so the spend has a table
            attached to it, not a click.
          </p>
        </div>
      </div>
      <figcaption>
        The gap every restaurant ad budget falls into, closed.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .mocks {
    padding-block: clamp(3rem, 7vw, 5rem);
    scroll-margin-top: 5rem;
  }

  .mocks__lede {
    margin-top: 1.25rem;
    color: var(--text-low);
  }

  .mocks__grid {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .mock {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .mock .stage {
    flex: 1;
  }

  .mock--wide {
    grid-column: 1 / -1;
  }

  figcaption {
    margin-top: 1.25rem;
    color: var(--text-mid);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 44ch;
  }

  /* ---- the stage each mockup floats on ---- */

  .stage {
    position: relative;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border-radius: 6px;
    background:
      radial-gradient(
        120% 130% at 78% 12%,
        color-mix(in oklab, var(--violet-700) 26%, transparent),
        transparent 62%
      ),
      var(--ink-700);
    border: 1px solid color-mix(in oklab, var(--violet-500) 22%, transparent);
    overflow: hidden;
  }

  /* ---- panels: the product surfaces themselves ---- */

  .panel {
    position: relative;
    background: var(--ink-600);
    border: 1px solid color-mix(in oklab, var(--violet-500) 34%, transparent);
    border-radius: 5px;
    box-shadow: 0 22px 44px -26px rgb(0 0 0 / 0.9);
  }

  .panel__head {
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid color-mix(in oklab, var(--violet-500) 24%, transparent);
  }

  .panel__head--row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .panel__eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-low);
  }

  .panel__name {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-hi);
  }

  .panel__name--sm {
    font-size: 1.05rem;
  }

  .panel__meta {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    color: var(--text-mid);
  }

  /* ---- 1. inbox ---- */

  .stage--inbox {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(2rem, 3.5rem) minmax(0, 1fr);
    align-items: center;
    align-content: center;
    gap: 0;
  }

  .chips {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.9rem;
    z-index: 1;
  }

  .chip {
    background: var(--ink-600);
    border: 1px solid color-mix(in oklab, var(--violet-500) 40%, transparent);
    border-radius: 4px;
    padding: 0.5rem 0.8rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-hi);
    white-space: nowrap;
    box-shadow: 0 10px 22px -14px rgb(0 0 0 / 0.9);
  }

  .wires {
    width: 100%;
    height: 100%;
    max-height: 13rem;
    fill: none;
    stroke: color-mix(in oklab, var(--violet-400) 65%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .thread {
    list-style: none;
    margin: 0;
    padding: 0.35rem 0 0.5rem;
  }

  .thread li {
    display: grid;
    grid-template-columns: 5.4rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.7rem 1.25rem;
  }

  .thread__src {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--violet-400);
  }

  .thread li p {
    font-size: 1rem;
    line-height: 1.45;
    color: var(--text-hi);
  }

  .thread__time {
    font-size: 0.875rem;
    color: var(--text-low);
    white-space: nowrap;
  }

  .thread .is-ours .thread__src,
  .thread .is-ours p {
    color: var(--mint-300);
  }

  /* ---- 2. after hours ---- */

  .stage--night {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-content: center;
    gap: 1.25rem;
  }

  .pulse {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--amber-400);
    box-shadow: 0 0 0 5px color-mix(in oklab, var(--amber-400) 20%, transparent);
    flex: none;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 1rem 1.25rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .steps li {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--text-mid);
  }

  .steps__dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--violet-400);
    translate: 0 -0.15em;
  }

  .steps .is-done {
    color: var(--mint-300);
    font-weight: 600;
  }

  .steps .is-done .steps__dot {
    background: var(--mint-400);
  }

  .tile {
    background: var(--ink-600);
    border: 1px solid color-mix(in oklab, var(--violet-500) 34%, transparent);
    border-radius: 5px;
    padding: 1.1rem 1.25rem;
    box-shadow: 0 22px 44px -26px rgb(0 0 0 / 0.9);
  }

  .tile__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-low);
  }

  .tile__value {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--mint-300);
  }

  .tile__note {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    color: var(--text-mid);
  }

  /* ---- 3. ad to table ---- */

  .stage--ads {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .flowcards {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0;
  }

  .fcard {
    background: var(--ink-600);
    border: 1px solid color-mix(in oklab, var(--violet-500) 34%, transparent);
    border-radius: 5px;
    padding: 1rem 1.15rem;
    box-shadow: 0 18px 38px -24px rgb(0 0 0 / 0.9);
  }

  .fcard--done {
    border-color: color-mix(in oklab, var(--mint-400) 55%, transparent);
  }

  .fcard__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-low);
  }

  .fcard__title {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.028em;
    color: var(--text-hi);
  }

  .fcard--done .fcard__title {
    color: var(--mint-300);
  }

  .fcard__meta {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    color: var(--text-mid);
  }

  .flowline {
    height: 1px;
    background: color-mix(in oklab, var(--violet-400) 60%, transparent);
    min-width: 1.25rem;
  }

  .attrib {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 24%, transparent);
  }

  .attrib__mark {
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--mint-400);
    display: grid;
    place-items: center;
  }

  .attrib__spark {
    width: 68%;
    height: 68%;
    color: var(--ink-900);
  }

  .attrib__text {
    max-width: 60ch;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-hi);
  }

  /* ---- responsive ---- */

  @media (max-width: 66rem) {
    .mocks__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .flowcards {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .flowline {
      width: 1px;
      height: 1.5rem;
      min-width: 0;
      margin-left: 1.25rem;
    }
  }

  @media (max-width: 40rem) {
    .stage--inbox {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .chips {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .wires {
      display: none;
    }
    .thread li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.3rem 0.6rem;
    }
    .thread__src {
      grid-column: 1 / -1;
    }
  }
</style>
