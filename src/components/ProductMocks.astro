---
import FeatureArt from "./FeatureArt.astro";
---

<section class="mocks" id="mocks" aria-labelledby="mocks-title">
  <div class="shell">
    <h2 class="eyeless-h2 mocks__title" id="mocks-title">
      What it looks like<br /> when it's working.
    </h2>
    <p class="lede mocks__lede">
      Three ordinary moments, as Chorus actually handles them.
    </p>
  </div>

  <div class="shell mocks__grid">
    <figure class="mock">
      <FeatureArt kind="inbox" />
      <figcaption>
        Three channels, three days, one person — and the kitchen already knows.
      </figcaption>
    </figure>

    <figure class="mock">
      <FeatureArt kind="afterhours" />
      <figcaption>
        The call you would have lost, booked before you woke up.
      </figcaption>
    </figure>

    <figure class="mock mock--wide">
      <FeatureArt kind="attribution" />
      <figcaption>
        The gap every restaurant ad budget falls into, closed.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .mocks {
    padding-block: clamp(3rem, 7vw, 5rem);
    scroll-margin-top: 5rem;
  }

  .mocks__lede {
    margin-top: 1.25rem;
    color: var(--text-low);
  }

  .mocks__grid {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .mock {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .mock :global(.art__stage) {
    flex: 1;
  }

  .mock--wide {
    grid-column: 1 / -1;
  }

  figcaption {
    margin-top: 1.25rem;
    color: var(--text-mid);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 44ch;
  }

  @media (max-width: 66rem) {
    .mocks__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
