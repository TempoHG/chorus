---
import TempoMark from "./TempoMark.astro";

/* The channels arrive scattered and out of time, then settle and connect to
   the Chorus node by a thin flow line each — a convergence, not a brace.
   Each channel's resting place is its real layout position; the scatter is a
   transform applied on top, so the arrival is compositor-safe. List matches
   the brief's own "flowing into Tempo Chorus" set exactly. */
const voices = [
  { label: "Website", dx: "-38vw", dy: "-9rem", rot: "-7deg" },
  { label: "Phone", dx: "22vw", dy: "-12rem", rot: "5deg" },
  { label: "Text", dx: "-26vw", dy: "8rem", rot: "4deg" },
  { label: "Email", dx: "30vw", dy: "-4rem", rot: "-6deg" },
  { label: "Social", dx: "-44vw", dy: "6rem", rot: "6deg" },
  { label: "Reviews", dx: "18vw", dy: "11rem", rot: "-4deg" },
  { label: "Events", dx: "-20vw", dy: "-14rem", rot: "7deg" },
  { label: "Guests", dx: "26vw", dy: "-8rem", rot: "-5deg" },
];
---

<div class="together">
  <ol class="together__voices">
    {
      voices.map((v, i) => (
        <li
          class="voice"
          style={`--dx:${v.dx}; --dy:${v.dy}; --rot:${v.rot}; --i:${i}`}
        >
          <span class="voice__name">{v.label}</span>
          <span class="voice__rule" aria-hidden="true" />
        </li>
      ))
    }
  </ol>

  <svg
    class="together__flow"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    {
      voices.map((v, i) => {
        const y = ((i + 0.5) / voices.length) * 100;
        return (
          <path
            class="together__strand"
            d={`M0 ${y.toFixed(2)} C 55 ${y.toFixed(2)}, 45 50, 100 50`}
            style={`--i:${i}`}
          />
        );
      })
    }
  </svg>

  <span class="together__node" aria-hidden="true">
    <span class="together__halo"></span>
    <span class="together__core">
      <TempoMark class="together__spark" />
    </span>
  </span>
</div>

<style>
  .together {
    --node: clamp(2.4rem, 5.2vw, 4.2rem);
    --flow: clamp(2.5rem, 6vw, 4.5rem);
    position: relative;
    padding-right: calc(var(--node) + var(--flow));
  }

  .together__voices {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.3rem, 0.9vw, 0.65rem);
  }

  .voice {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(2rem, 1fr);
    align-items: center;
    gap: clamp(0.7rem, 2vw, 1.25rem);
  }

  .voice__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.05rem);
    letter-spacing: -0.025em;
    color: var(--text-hi);
    white-space: nowrap;
  }

  .voice__rule {
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--violet-500) 30%, transparent),
      color-mix(in oklab, var(--violet-500) 80%, transparent)
    );
  }

  /* The flow lines: one per channel, converging on the node. */
  .together__flow {
    position: absolute;
    top: 0;
    right: var(--node);
    width: var(--flow);
    height: 100%;
    overflow: visible;
  }

  .together__strand {
    fill: none;
    stroke: color-mix(in oklab, var(--violet-400) 65%, transparent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .together__node {
    position: absolute;
    top: 50%;
    right: 0;
    translate: 0 -50%;
    width: var(--node);
    height: var(--node);
    display: grid;
    place-items: center;
  }

  .together__halo {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: color-mix(in oklab, var(--mint-400) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--mint-400) 42%, transparent);
  }

  .together__core {
    position: relative;
    width: 68%;
    height: 68%;
    border-radius: 50%;
    background: var(--mint-400);
    display: grid;
    place-items: center;
  }

  .together__spark {
    width: 46%;
    height: 46%;
    color: var(--ink-900);
  }

  /* ---- The arrival ---- */

  :global(.js) .voice,
  :global(.js) .together__strand,
  :global(.js) .together__node {
    opacity: 0;
  }

  :global(.js) .voice {
    translate: var(--dx) var(--dy);
    rotate: var(--rot);
    animation: settle 1.15s var(--ease-out) forwards;
    animation-delay: calc(160ms + var(--i) * 85ms);
  }

  :global(.js) .together__strand {
    animation: strand-fade 0.6s var(--ease-out) forwards;
    animation-delay: calc(1.05s + var(--i) * 60ms);
  }

  :global(.js) .together__node {
    animation: node-in 0.75s var(--ease-out) 1.55s forwards;
  }

  @keyframes settle {
    from {
      opacity: 0;
      translate: var(--dx) var(--dy);
      rotate: var(--rot);
      filter: blur(5px);
    }
    to {
      opacity: 1;
      translate: 0 0;
      rotate: 0deg;
      filter: blur(0);
    }
  }

  @keyframes strand-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes node-in {
    from {
      opacity: 0;
      scale: 0.5;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .voice,
    :global(.js) .together__strand,
    :global(.js) .together__node {
      opacity: 1;
      translate: none;
      rotate: none;
      animation: none;
    }
  }
</style>
