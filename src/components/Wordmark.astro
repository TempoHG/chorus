---
interface Props {
  height?: number;
  tone?: "light-ground" | "dark-ground";
  class?: string;
}
const { height = 40, tone = "light-ground", class: className = "" } = Astro.props;
const isWordmark = tone === "dark-ground";
const src = isWordmark ? "/brand/chorus-wordmark.svg" : "/brand/chorus-logo.svg";
const ratio = isWordmark ? 320.34 / 54 : 320.34 / 96;
---

<img
  class={`wordmark ${className}`}
  src={src}
  alt="Tempo Chorus"
  width={Math.round(height * ratio)}
  height={height}
  style={`height:${height}px`}
  decoding="async"
/>

<style>
  .wordmark {
    display: block;
    width: auto;
  }
</style>
