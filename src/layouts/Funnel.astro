---
// Minimal layout for standalone lead-gen funnel pages (the Restaurant
// Growth Playbook landing + thank-you pages). Deliberately NOT Base.astro:
// the brief calls for "no large navigation menu, no unrelated promotional
// content" — a funnel page exists to get the visitor to one action, not to
// route them around the rest of the site. Same <head> boilerplate as
// Base.astro (GTM, favicons, analytics) plus Open Graph/Twitter tags Base
// doesn't carry, since this page is built to be shared from ads and posts.
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
}
const { title, description, path, ogImage = "/img/playbook/cover.jpg" } = Astro.props;
const siteOrigin = "https://www.thgchorus.com";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager. First thing in <head>, per GTM's own install
         instructions — keep tags/triggers in the GTM container itself
         rather than hardcoding them here. -->
    <script is:inline>
      (function () {
        const GTM_ID = "GTM-NS5MKTGH";
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", GTM_ID);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${siteOrigin}${path}`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteOrigin}${ogImage}`} />
    <meta property="og:url" content={`${siteOrigin}${path}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteOrigin}${ogImage}`} />

    <link rel="icon" type="image/svg+xml" href="/brand/thg-icon.svg" />
    <link rel="alternate icon" type="image/png" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <Analytics />
  </head>
  <body class="funnel">
    <!-- Google Tag Manager (noscript). First thing in the body, per GTM. -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NS5MKTGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>

    <a class="skip" href="#main">Skip to content</a>

    <header class="funnel__header">
      <div class="shell funnel__header-inner">
        <a class="funnel__mark" href="/" aria-label="Tempo Chorus home">
          <Wordmark height={28} />
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="funnel__footer">
      <div class="shell funnel__footer-inner">
        <a href="/" aria-label="Tempo Chorus home">
          <Wordmark height={24} tone="dark-ground" />
        </a>
        <p class="funnel__attribution">A Tempo Hospitality Group platform</p>
        <nav class="funnel__legal" aria-label="Legal">
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms</a>
        </nav>
        <p class="funnel__copyright">© {year} Tempo Hospitality Group. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .funnel__header {
    padding-block: 1.25rem;
    border-bottom: 1px solid color-mix(in oklab, var(--eggplant) 10%, transparent);
  }

  .funnel__header-inner {
    display: flex;
  }

  .funnel__mark {
    display: inline-flex;
  }

  .funnel__footer {
    padding-block: clamp(2.5rem, 6vw, 3.5rem);
    background: var(--eggplant);
    color: var(--white);
  }

  .funnel__footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .funnel__attribution {
    font-size: 0.85rem;
    color: color-mix(in oklab, var(--white) 70%, transparent);
  }

  .funnel__legal {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
    font-size: 0.85rem;
  }

  .funnel__legal a {
    color: color-mix(in oklab, var(--white) 85%, transparent);
    text-decoration: none;
  }

  .funnel__legal a:hover {
    color: var(--allium);
  }

  .funnel__copyright {
    flex-basis: 100%;
    font-size: 0.78rem;
    color: color-mix(in oklab, var(--white) 55%, transparent);
  }

  @media (max-width: 36rem) {
    .funnel__legal {
      margin-left: 0;
    }
  }
</style>
