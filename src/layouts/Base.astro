---
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";
import Analytics from "@vercel/analytics/astro";
import OnboardingPopup from "../components/OnboardingPopup.astro";

interface Props {
  title: string;
  description: string;
  active?:
    | "home"
    | "features"
    | "guest-marketing"
    | "manage-reviews"
    | "private-events"
    | "websites"
    | "ai-host-helper"
    | "pricing";
}
const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager. First thing in <head>, per GTM's own install
         instructions — keep tags/triggers in the GTM container itself
         rather than hardcoding them here. -->
    <script is:inline>
      (function () {
        const GTM_ID = "GTM-NS5MKTGH";
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", GTM_ID);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/thg-icon.svg" />
    <link rel="alternate icon" type="image/png" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <Analytics />
  </head>
  <body>
    <!-- Google Tag Manager (noscript). First thing in the body, per GTM. -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NS5MKTGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>
    <!--
      THESIS: A restaurant's scattered guest channels visibly flow together into one
      platform. Refuses the SaaS feature-icon grid, the "all-in-one platform"
      claim-without-proof hero, and (per the client brief) literal musical notation.
      OWN-WORLD: Night navy ground; violet hairlines and flow-line connectors as the
      component language; brand green marks what Chorus resolves — the answered moment,
      the confirmed booking, the primary action; amber marks the unresolved. Authored
      UI-mockup panels (inbox, calendar, reviews, service) are the primary proof system.
      Poppins display over Archivo text.
      STORY: The operator learns in one image that scattered channels become one
      platform, sees the four jobs it does (Get Found, Stay Connected, Bring Guests
      Back, Save Time), accumulates belief through concrete guest moments and Restaurant
      Systems, understands pricing in seconds, then books a demo.
      FIRST VIEWPORT: Headline left over a right-hand field of channel labels that arrive
      scattered and settle, each joined by a thin flow line converging on the Tempo node,
      badged at the edge of a stylized phone running a restaurant menu screen; green
      action inline beneath the sub.
      FORM: Brief-pinned redesign, retiring the prior Vignette-Chain Spine (seed key
      a75a316e) notation system per Tempo_Chorus_Website_Design_Brief_for_Claude.docx.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="shell masthead__inner">
        <a class="masthead__mark" href="/"><Wordmark height={38} /></a>
        <nav class="masthead__nav" aria-label="Primary">
          <!-- Desktop: a dropdown trigger, always visible, opening a flat
               list of named destinations — the trigger itself is never
               hidden, so this doesn't violate the No-Hidden-Menu Rule.
               Hidden below 46rem in favor of the flattened links below. -->
          <details class="masthead__dropdown">
            <summary
              aria-current={
                active === "features" || active === "guest-marketing" || active === "manage-reviews" || active === "private-events"
                  ? "page"
                  : undefined
              }
            >
              Features
            </summary>
            <nav class="dropdown__panel" aria-label="Features">
              <a href="/features" aria-current={active === "features" ? "page" : undefined}>All Features</a>
              <a href="/guest-marketing" aria-current={active === "guest-marketing" ? "page" : undefined}>Guest Marketing</a>
              <a href="/manage-reviews" aria-current={active === "manage-reviews" ? "page" : undefined}>Manage Reviews</a>
              <a href="/private-events-catering" aria-current={active === "private-events" ? "page" : undefined}>Private Events & Catering</a>
            </nav>
          </details>

          <!-- Mobile (≤46rem): the dropdown flattens into plain sibling
               links in the scrollable row — nothing hidden, nothing demoted
               off the masthead. Hidden at desktop widths. -->
          <a
            class="masthead__mobile-only"
            href="/features"
            aria-current={active === "features" ? "page" : undefined}
          >
            All Features
          </a>
          <a
            class="masthead__mobile-only"
            href="/guest-marketing"
            aria-current={active === "guest-marketing" ? "page" : undefined}
          >
            Guest Marketing
          </a>
          <a
            class="masthead__mobile-only"
            href="/manage-reviews"
            aria-current={active === "manage-reviews" ? "page" : undefined}
          >
            Manage Reviews
          </a>
          <a
            class="masthead__mobile-only"
            href="/private-events-catering"
            aria-current={active === "private-events" ? "page" : undefined}
          >
            Private Events & Catering
          </a>

          <a href="/websites-menus" aria-current={active === "websites" ? "page" : undefined}>Websites & Menus</a>
          <a href="/ai-host-helper" aria-current={active === "ai-host-helper" ? "page" : undefined}>AI Host Helper</a>
          <a href="/pricing" aria-current={active === "pricing" ? "page" : undefined}>Pricing</a>
          <a class="btn masthead__cta" href="/#demo">Book a Demo</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="shell footer__inner">
        <div class="footer__brand">
          <Wordmark height={34} />
          <p>
            A <a class="footer__brand-link" href="https://www.tempohg.com" rel="noopener">Tempo Hospitality Group</a> product.<br />
            Built for the people who actually run restaurants.
          </p>
        </div>
        <nav class="footer__nav" aria-label="Footer">
          <div class="footer__nav-col">
            <a href="/">Overview</a>
            <a href="/websites-menus">Websites & Menus</a>
            <a href="/ai-host-helper">AI Host Helper</a>
            <a href="/pricing">Pricing</a>
            <a href="/#demo">Book a Demo</a>
          </div>
          <div class="footer__nav-col">
            <a href="/features">All Features</a>
            <a href="/guest-marketing">Guest Marketing</a>
            <a href="/manage-reviews">Manage Reviews</a>
            <a href="/private-events-catering">Private Events & Catering</a>
          </div>
        </nav>
      </div>
      <div class="shell footer__base">
        <p>
          <a class="footer__corp" href="https://www.tempohg.com" rel="noopener">
            &copy; {new Date().getFullYear()} Tempo Hospitality Group.
          </a>
        </p>
        <p>All guest moments shown on this site are illustrative.</p>
      </div>
    </footer>

    <OnboardingPopup />

    <script>
      import { initMotion } from "../scripts/motion.js";
      initMotion();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--mint-400);
    color: var(--ink-900);
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    z-index: 100;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
  }

  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--ink-900) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in oklab, var(--violet-500) 22%, transparent);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }

  .masthead__mark {
    text-decoration: none;
    display: inline-flex;
  }

  .masthead__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2rem);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .masthead__nav a {
    text-decoration: none;
    color: var(--text-mid);
    padding-block: 0.3rem;
    border-bottom: 2px solid transparent;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .masthead__nav a:hover {
    color: var(--text-hi);
    border-bottom-color: var(--violet-400);
  }

  .masthead__nav a[aria-current="page"] {
    color: var(--text-hi);
    border-bottom-color: var(--mint-400);
  }

  .masthead__nav a.masthead__cta {
    padding: 0.6rem 1.15rem;
    color: var(--ink-900);
    border-bottom: 0;
  }

  .masthead__nav a.masthead__cta:hover {
    color: var(--ink-900);
  }

  /* Desktop-only "Features ▾" dropdown. The trigger is always visible and
     the panel is a flat list of named destinations, so this doesn't hide
     anything — it just groups four related links under one label. Below
     46rem it's replaced entirely by the flattened .masthead__mobile-only
     links (see below and the media query), never shown at the same time. */
  .masthead__dropdown {
    position: relative;
  }

  .masthead__dropdown summary {
    cursor: pointer;
    color: var(--text-mid);
    padding-block: 0.3rem;
    border-bottom: 2px solid transparent;
    list-style: none;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .masthead__dropdown summary::-webkit-details-marker {
    display: none;
  }

  .masthead__dropdown summary::after {
    content: " \25BE";
  }

  .masthead__dropdown summary:hover,
  .masthead__dropdown[open] summary {
    color: var(--text-hi);
    border-bottom-color: var(--violet-400);
  }

  .masthead__dropdown summary[aria-current="page"] {
    color: var(--text-hi);
    border-bottom-color: var(--mint-400);
  }

  .dropdown__panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    min-width: 14rem;
    padding: 0.5rem;
    background: var(--ink-600);
    border: 1px solid color-mix(in oklab, var(--violet-500) 34%, transparent);
    border-radius: 5px;
    box-shadow: 0 22px 44px -26px rgb(0 0 0 / 0.9);
  }

  .dropdown__panel a {
    padding: 0.55rem 0.7rem;
    border-radius: 4px;
    border-bottom: 0 !important;
  }

  .dropdown__panel a:hover {
    background: color-mix(in oklab, var(--violet-600) 22%, transparent);
  }

  .masthead__mobile-only {
    display: none;
  }

  /* Phones get the whole site, not a hidden menu: the bar becomes two rows. */
  @media (max-width: 46rem) {
    .masthead__dropdown {
      display: none;
    }

    .masthead__mobile-only {
      display: block;
    }

    .masthead__inner {
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      padding-block: 0.7rem 0;
    }

    .masthead__nav {
      order: 3;
      width: 100%;
      gap: 1.35rem;
      border-top: 1px solid color-mix(in oklab, var(--violet-500) 20%, transparent);
      padding-block: 0.15rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .masthead__nav::-webkit-scrollbar {
      display: none;
    }

    .masthead__nav a:not(.masthead__cta) {
      white-space: nowrap;
      padding-block: 0.55rem;
    }

    .masthead__nav a.masthead__cta {
      order: -1;
      position: absolute;
      top: 0.7rem;
      right: var(--gutter);
      padding: 0.5rem 0.95rem;
    }

    .masthead__inner {
      position: relative;
    }
  }

  .footer {
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 24%, transparent);
    background: var(--ink-800);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 4rem;
    align-items: flex-start;
  }

  .footer__brand {
    flex: 1 1 22rem;
  }

  .footer__brand p {
    margin-top: 1.1rem;
    color: var(--text-mid);
    max-width: 52ch;
    font-size: 0.875rem;
  }

  .footer__brand-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }

  .footer__brand-link:hover {
    color: var(--text-hi);
  }

  .footer__nav {
    display: flex;
    gap: 2.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .footer__nav-col {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer__nav a {
    color: var(--text-mid);
    text-decoration: none;
  }

  .footer__nav a:hover {
    color: var(--mint-400);
  }

  .footer__base {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklab, var(--violet-500) 16%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    color: var(--text-low);
    font-size: 0.875rem;
  }

  .footer__corp {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .footer__corp:hover {
    color: var(--text-mid);
    border-bottom-color: color-mix(in oklab, var(--violet-400) 55%, transparent);
  }
</style>
